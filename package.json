{
  "name": "ai-architecture-portfolio",
  "version": "1.22.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:webkit": "PW_WEBKIT_PODMAN=1 playwright test --project=webkit",
    "test:e2e:staging": "playwright test --config playwright.staging.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "packageManager": "pnpm@12.10.1",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.8",
    "satori": "^0.44.0",
    "satori-html": "^0.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/jsdom": "^30.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,astro}": "eslint --fix"
  }
}
