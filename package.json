{
  "name": "ai-architecture-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:webkit": "PW_WEBKIT_PODMAN=1 playwright test --project=webkit",
    "test:e2e:staging": "playwright test --config playwright.staging.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "packageManager": "pnpm@12.10.1",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.2",
    "satori": "^0.63.2",
    "satori-html": "^0.3.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.js|*.ts|*.mjs|*.cjs|*.astro)": "prettier --write --ignore-unknown"
  }
}
