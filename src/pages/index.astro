---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/consts';
import AboutMe from '@/components/AboutMe.astro';
import BlogPostFeatured from './_BlogPostFeatured.astro';
import BlogPostRecommended from '@/components/BlogPostRecommended.astro';
import Now from './_Now.astro';

const aboutMeData = {
    name: SITE.name,
    profession: SITE.role,
    text: SITE.pitch,
    githubUrl: "https://github.com/Alexits93",
    linkedinUrl: "https://www.linkedin.com/in/patrik-alexits/",
    instagramUrl: "https://www.instagram.com/akelafreestyle/",
    stackoverflowUrl: "https://stackoverflow.com/users/9327050/patrik-alexits"
};
---

<BaseLayout title={SITE.title} description={SITE.description}>
	<main>
		<div class="home-wrapper">
			<AboutMe
				name={aboutMeData.name}
				profession={aboutMeData.profession}
				text={aboutMeData.text}
				githubUrl={aboutMeData.githubUrl}
				linkedinUrl={aboutMeData.linkedinUrl}
				instagramUrl={aboutMeData.instagramUrl}
				stackoverflowUrl={aboutMeData.stackoverflowUrl}
			/>
			<div class="home-blocks">
				<Now />
				<BlogPostFeatured />
				<BlogPostRecommended />
			</div>
		</div>
	</main>
</BaseLayout>

<style>
	/* AboutMe renders its own root, so :global() reaches it from this page. Sticky intro column as on /cv/ (#214). */
	.home-wrapper { display: flex; flex-direction: column; gap: var(--space-12); }
	.home-blocks { display: flex; flex-direction: column; gap: var(--space-12); }
	@media (min-width: 64rem) {
		.home-wrapper { display: grid; grid-template-columns: 1fr 1fr; align-items: start; }
		.home-wrapper > :global(section#about-me) { position: sticky; top: var(--space-24); }
		/* The blog widgets size their grids for a full-width page; in the half-width column they start at the left
		   edge and keep two columns. The .home-wrapper ancestor outranks the widgets' own scoped selectors, which tie
		   with .home-blocks alone and load later. #219 replaces both widgets on home. */
		.home-wrapper .home-blocks :global(#blog-featured .wrapper) { justify-content: flex-start; }
		.home-wrapper .home-blocks :global(#blog-section .wrapper) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
</style>
