---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/consts';
import Contact from './_Contact.astro';
import Faq from './_Faq.astro';
import Hero from './_Hero.astro';
import Now from './_Now.astro';
import Principles from './_Principles.astro';
import Services from './_Services.astro';
import Work from './_Work.astro';
import Writing from './_Writing.astro';
---

<BaseLayout title={SITE.title} description={SITE.description}>
	<main>
		<Hero />
		<Now />
		<Services />
		<Work />
		<Principles />
		<Writing />
		<Faq />
		<Contact />
	</main>
</BaseLayout>

