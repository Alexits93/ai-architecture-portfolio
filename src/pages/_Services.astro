---
// Page-only component for the home page (ADR 002): "What I do best", cards from src/content/services.yaml that stack
// while the page scrolls.
import { getCollection } from "astro:content";
import Card from "@/components/Card.astro";
import DisplayHeading from "@/components/DisplayHeading.astro";
import Eyebrow from "@/components/Eyebrow.astro";

const services = (await getCollection("services")).toSorted(
  (a, b) => a.data.order - b.data.order,
);
import TagList from "@/components/TagList.astro";
---

<section id="services" class="services" aria-labelledby="services-title">
  <div class="intro">
    <Eyebrow>Skills</Eyebrow>
    <DisplayHeading
      as="h2"
      size="section"
      id="services-title"
      class="title"
      text="What I do"
      accent="best"
    />
    <p>Some things I do every week, at work and in my free time.</p>
  </div>
  <ol class="stack">
    {services.map(({ data }) => (
      <Card as="li" class="service">
        <Eyebrow slash={false}>{data.kicker}</Eyebrow>
        <DisplayHeading
          as="h3"
          size="card"
          class="name"
          text={`${String(data.order).padStart(2, "0")}. ${data.title}`}
        />
        <p>{data.text}</p>
        <TagList items={data.tools} />
      </Card>
    ))}
  </ol>
</section>

<style>
  .services {
    display: grid;
    gap: var(--space-12);
    padding-block: var(--space-12);
  }
  .title {
    margin: 0 0 var(--space-4);
  }
  .intro > p:last-child {
    margin: 0;
    max-inline-size: var(--size-pitch);
    color: var(--font-color);
  }

  /* Each card sticks a little lower than the one before, so they pile up while the page scrolls. position: sticky
     works in every engine (https://developer.mozilla.org/en-US/docs/Web/CSS/position#sticky). */
  .stack {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--space-stack-end);
    display: grid;
    gap: var(--space-stack);
  }
  .service {
    position: sticky;
    top: calc(var(--offset-sticky) + var(--i) * var(--space-8));
    rotate: calc((var(--i) - 1) * 1.2deg);
  }
  .service:nth-child(1) {
    --i: 0;
  }
  .service:nth-child(2) {
    --i: 1;
  }
  .service:nth-child(3) {
    --i: 2;
  }
  .service:nth-child(4) {
    --i: 3;
  }
  .name {
    margin: 0 0 var(--space-4);
  }
  .service > p {
    margin: 0 0 var(--space-6);
  }

  /* At 400% zoom (320x180 CSS px) the next card covers a stuck card before its text can be read. */
  @media (max-height: 20rem) {
    .service {
      position: static;
    }
  }

  /* On wide screens the intro sticks on the left while the cards pass on the right. */
  @media (min-width: 64rem) {
    .services {
      grid-template-columns: 2fr 3fr;
      align-items: start;
    }
    .intro {
      position: sticky;
      top: var(--offset-sticky);
    }
  }

  /* Where scroll-driven animations exist, a card settles from a stronger tilt as it enters. Firefox shows the
     resting tilt (https://developer.mozilla.org/en-US/docs/Web/CSS/animation-timeline#browser_compatibility). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Longhands: the minifier folds a separate animation-timeline into the shorthand, which Chromium rejects. */
      .service {
        animation-name: card-settle;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: var(--range-reveal);
      }
    }
  }
  @keyframes card-settle {
    from {
      rotate: 6deg;
      translate: 0 var(--space-16);
      opacity: 0.4;
    }
  }
</style>
