---
// Page-only component for the home page (ADR 002): the principles from src/content/principles/principles.md (#244),
// numbered rows between Work and the writing in direction A's look (#258, decided on #252).
import { getEntry, render } from 'astro:content';
import DisplayHeading from '@/components/DisplayHeading.astro';
import Eyebrow from '@/components/Eyebrow.astro';

const principles = await getEntry('principles', 'principles');
if (principles === undefined) throw new Error('src/content/principles/principles.md is missing');
const { Content } = await render(principles);
---

<section id="principles" class="principles" aria-labelledby="principles-title">
	<div class="intro">
		<Eyebrow>How I work</Eyebrow>
		<DisplayHeading as="h2" size="section" id="principles-title" accent="Principles" />
	</div>
	<div class="text"><Content /></div>
</section>

<style>
	.principles { display: grid; gap: var(--space-8); padding-block: var(--space-12); color: var(--font-color); }

	/* Rows share the list's columns through subgrid, so every text starts at the same x
	   (https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_grid_layout/Subgrid).
	   Content renders Markdown outside this component's scope, so :global() reaches its list. A grid row is no longer a
	   list-item, so the built-in list-item counter stays at 0; a named counter numbers the rows
	   (https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_counter_styles/Using_CSS_counters). */
	.text :global(ul) {
		list-style: none; margin: 0; padding: 0; counter-reset: principle;
		display: grid; grid-template-columns: auto 1fr; column-gap: var(--space-4);
	}
	.text :global(li) {
		counter-increment: principle;
		display: grid; grid-column: 1 / -1; grid-template-columns: subgrid; padding-block: var(--space-4);
		border-block-start: var(--border-width-hairline) solid var(--hairline-color);
		color: var(--font-color-bold); font-size: var(--font-size-xl); letter-spacing: var(--letter-spacing-tight);
	}
	.text :global(li::before) {
		content: counter(principle, decimal-leading-zero); color: var(--font-color);
		font-size: var(--font-size-sm); font-variant-numeric: tabular-nums; line-height: inherit;
	}

	/* On wide screens the intro sticks on the left while the rows pass on the right, as in the services. */
	@media (min-width: 64rem) {
		.principles { grid-template-columns: 2fr 3fr; align-items: start; }
		.intro { position: sticky; top: var(--offset-sticky); }
	}
</style>
