---
import { Header } from '@/widgets/header';
import { NavigatorMenu } from '@/widgets/navigator-menu';
import { AboutMe } from '@/widgets/about-me';
import { ExperienceList } from '@/widgets/experience-list';
import '@/shared/styles/global.css';

const aboutMeData = {
    name: "Patrik Alexits",
    profession: "Frontend Software Engineer",
    text: "Bringing 7+ years of experience in web development with an emphasis on front-end technologies. Expert in enhancing user interfaces and ensuring accessibility, delivering projects that consistently meet rigorous web standards.",
    spotifyTrackId: "60a0Rd6pjrkxjPbaKzXjfq",
    githubUrl: "https://github.com/Alexits93",
    linkedinUrl: "https://www.linkedin.com/in/patrik-alexits/",
    instagramUrl: "https://www.instagram.com/akelafreestyle/",
    stackoverflowUrl: "https://stackoverflow.com/users/9327050/patrik-alexits"
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>CV - Patrik Alexits</title>
	</head>
	<body>
		<Header />
		<NavigatorMenu />
		<main>
			<section id="page-wrapper">
                <AboutMe
                    name={aboutMeData.name}
                    profession={aboutMeData.profession}
                    text={aboutMeData.text}
                    spotifyTrackId={aboutMeData.spotifyTrackId}
                    githubUrl={aboutMeData.githubUrl}
                    linkedinUrl={aboutMeData.linkedinUrl}
                    instagramUrl={aboutMeData.instagramUrl}
                    stackoverflowUrl={aboutMeData.stackoverflowUrl}
                />
                <ExperienceList />
            </section>
		</main>
	</body>
</html>

<style>
    section#page-wrapper {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    ::selection {
        background-color: var(--theme-primary);
    }

    @media (min-width: 768px) {
        section#page-wrapper {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: start;
        }

        section#page-wrapper :global(section#about-me) {
            position: sticky;
            top: 6rem;
        }
    }
</style>
