---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ROUTES, SITE, SOCIAL_LINKS } from '@/consts';
import { profilePageJsonLd } from '@/lib/json-ld';
import AboutMe from './_AboutMe.astro';
import ExperienceList from './_ExperienceList.astro';

const aboutMeData = {
    name: SITE.name,
    profession: SITE.role,
    text: "Bringing 7+ years of experience in web development with an emphasis on front-end technologies. Expert in enhancing user interfaces and ensuring accessibility, delivering projects that consistently meet rigorous web standards.",
    githubUrl: SOCIAL_LINKS.github,
    linkedinUrl: SOCIAL_LINKS.linkedin,
    instagramUrl: SOCIAL_LINKS.instagram,
    stackoverflowUrl: SOCIAL_LINKS.stackoverflow
};
const jsonLd = profilePageJsonLd(new URL(ROUTES.home, Astro.site).href);
---

<BaseLayout title="CV | Patrik Alexits" description="Experience and skills of Patrik Alexits, frontend architect and software engineer." jsonLd={jsonLd}>
	<main>
		<section id="page-wrapper">
                <AboutMe
                    name={aboutMeData.name}
                    profession={aboutMeData.profession}
                    text={aboutMeData.text}
                    githubUrl={aboutMeData.githubUrl}
                    linkedinUrl={aboutMeData.linkedinUrl}
                    instagramUrl={aboutMeData.instagramUrl}
                    stackoverflowUrl={aboutMeData.stackoverflowUrl}
                />
                <ExperienceList />
            </section>
	</main>
</BaseLayout>

<style>
	/* AboutMe and ExperienceList render their own roots, so :global() reaches them from this page. On wide screens the
	   about block sticks on the left while the positions pass on the right, as the home services do. */
	section#page-wrapper { display: grid; gap: var(--space-16); }
	@media (min-width: 64rem) {
		section#page-wrapper { grid-template-columns: 2fr 3fr; align-items: start; }
		section#page-wrapper :global(section#about-me) { position: sticky; top: var(--offset-sticky); }
	}
</style>
