---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/consts';
import AboutMe from '@/components/AboutMe.astro';
import ExperienceList from './_ExperienceList.astro';

const aboutMeData = {
    name: SITE.name,
    profession: SITE.role,
    text: "Bringing 7+ years of experience in web development with an emphasis on front-end technologies. Expert in enhancing user interfaces and ensuring accessibility, delivering projects that consistently meet rigorous web standards.",
    githubUrl: "https://github.com/Alexits93",
    linkedinUrl: "https://www.linkedin.com/in/patrik-alexits/",
    instagramUrl: "https://www.instagram.com/akelafreestyle/",
    stackoverflowUrl: "https://stackoverflow.com/users/9327050/patrik-alexits"
};
---

<BaseLayout title="CV | Patrik Alexits" description="Experience and skills of Patrik Alexits, frontend architect and software engineer.">
	<main>
		<section id="page-wrapper">
                <AboutMe
                    name={aboutMeData.name}
                    profession={aboutMeData.profession}
                    text={aboutMeData.text}
                    githubUrl={aboutMeData.githubUrl}
                    linkedinUrl={aboutMeData.linkedinUrl}
                    instagramUrl={aboutMeData.instagramUrl}
                    stackoverflowUrl={aboutMeData.stackoverflowUrl}
                />
                <ExperienceList />
            </section>
	</main>
</BaseLayout>

<style>
	/* AboutMe and ExperienceList render their own roots, so :global() reaches them from this page. */
	section#page-wrapper { display: flex; flex-direction: column; gap: var(--space-12); }
	section#page-wrapper > :global(.experience-list-container) { align-self: flex-end; }
	@media (min-width: 48rem) {
		section#page-wrapper { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); align-items: start; }
		section#page-wrapper > :global(.experience-list-container) { align-self: auto; }
		section#page-wrapper :global(section#about-me) { position: sticky; top: var(--space-24); }
	}
</style>
