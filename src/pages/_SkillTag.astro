---
// A skill under a CV position, drawn like the tool tags on the home service cards (#301).
interface Props {
  skill: string;
}

const { skill } = Astro.props;
---

<span class="skill-tag">{skill}</span>

<style>
  .skill-tag {
    display: block; padding: var(--space-1) var(--space-4); border-radius: var(--radius-pill);
    font-size: var(--font-size-sm); border: var(--border-width-hairline) solid var(--hairline-color);
  }
</style>
