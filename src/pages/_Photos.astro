---
// Page-only component for the home page (ADR 002): a full-width row of tilted photos under the hero,
// with the owner's photos.
import { Image } from "astro:assets";
import balloon from "@/assets/photos/row-1-balloon.jpg";
import stadium from "@/assets/photos/row-2-stadium.jpg";
import seoul from "@/assets/photos/row-3-seoul.jpg";
import porsche from "@/assets/photos/row-4-porsche.jpg";
import alpinePass from "@/assets/photos/row-5-alpine-pass.jpg";
import BarsButton from "@/components/BarsButton.astro";

const photos = [
  {
    src: balloon,
    alt: "My wife and me at The ICE festival in St. Moritz, Switzerland",
  },
  {
    src: stadium,
    alt: "In the Santiago Bernabéu stadium in Madrid, Spain. Hala Madrid!",
  },
  {
    src: seoul,
    alt: "My wife in a hanbok, seen from behind, in front of a Korean pagoda",
  },
  {
    src: porsche,
    alt: "Sitting in my dream Porsche, a 911 930 Turbo Slant Nose",
  },
  { src: alpinePass, alt: "My wife and me on the Gotthard Pass, Switzerland" },
];
---

{/* The row scrolls where it overflows. tabindex lets keyboard users scroll it: WebKit does not focus a scroller on its
    own (axe scrollable-region-focusable). The focusable row needs a role and a name; a group, not a region landmark,
    because Orca 51's next-landmark command loops on a landmark whose first content is an image. */}
<div id="photos" class="photos" role="group" aria-label="Photos" tabindex="0">
  <ul>
    {/* Below the fold, so Astro's default loading="lazy" applies. The widths cover --size-photo up to 3x. draggable="false"
		    stops the browser's native image drag, which would cancel the row's mouse drag.
		    Each photo opens its own dialog through an invoker command, no script needed
		    (https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/button#commandfor). closedby="any" closes it
		    on Esc and on a click outside. The caption repeats the alt text and names the dialog, so the large image has an
		    empty alt and is not read twice. A closed dialog is not rendered, so its lazy image loads only when opened. */}
    {photos.map(({ src, alt }, index) => {
      const id = `photo-${index + 1}`;
      return (
        <li>
          <button
            type="button"
            class="open"
            commandfor={id}
            command="show-modal"
          >
            <Image
              class="photo"
              src={src}
              alt={alt}
              widths={[200, 400, 600, 816]}
              sizes="clamp(12rem, 22vw, 17rem)"
              quality={70}
              draggable="false"
            />
          </button>
          <dialog
            id={id}
            class="viewer"
            closedby="any"
            aria-labelledby={`${id}-caption`}
          >
            <BarsButton
              commandfor={id}
              command="close"
              aria-label="Close photo"
            />
            <figure>
              <Image
                class="large"
                src={src}
                alt=""
                widths={[600, 900]}
                sizes="min(90vw, 72vh)"
                quality={80}
              />
              <figcaption id={`${id}-caption`}>{alt}</figcaption>
            </figure>
          </dialog>
        </li>
      );
    })}
  </ul>
</div>

<script>
  // Touch, the wheel and the keyboard scroll the row natively; a mouse drag does not, so this script adds it.
  // Pointer capture keeps the drag going when the mouse leaves the row
  // (https://developer.mozilla.org/en-US/docs/Web/API/Element/setPointerCapture).
  const row = document.getElementById("photos");
  if (row !== null) {
    // The grab cursor shows only where the row overflows and there is something to drag.
    new ResizeObserver(() =>
      row.toggleAttribute("data-draggable", row.scrollWidth > row.clientWidth),
    ).observe(row);
    // The row starts at its middle, so both outer photos sit partly off screen. A scroller starts at its left edge,
    // and scroll-initial-target, which could pick the middle photo in CSS, ships in Chromium only
    // (https://developer.mozilla.org/en-US/docs/Web/CSS/scroll-initial-target).
    row.scrollLeft = (row.scrollWidth - row.clientWidth) / 2;
    let startX = 0;
    let startScroll = 0;
    let pressed: number | null = null;
    // The open photo's dialog sits inside the row; a press there is not a drag.
    const inDialog = (target: EventTarget | null) =>
      target instanceof Element && target.closest("dialog") !== null;
    row.addEventListener("pointerdown", (event) => {
      if (
        event.pointerType !== "mouse" ||
        event.button !== 0 ||
        !row.hasAttribute("data-draggable") ||
        inDialog(event.target)
      )
        return;
      pressed = event.pointerId;
      startX = event.clientX;
      startScroll = row.scrollLeft;
    });
    // The capture starts only once the mouse moves: a captured press ends on the row, so a click would no longer
    // reach the photo and open it.
    row.addEventListener("pointermove", (event) => {
      if (event.pointerId !== pressed || event.buttons !== 1) return;
      if (!row.hasPointerCapture(event.pointerId)) {
        if (Math.abs(event.clientX - startX) < 4) return;
        row.setPointerCapture(event.pointerId);
        row.toggleAttribute("data-dragging", true);
      }
      row.scrollLeft = startScroll - (event.clientX - startX);
    });
    row.addEventListener("pointerup", () => {
      pressed = null;
    });
    row.addEventListener("lostpointercapture", () =>
      row.toggleAttribute("data-dragging", false),
    );

    // Where same-document View Transitions exist and motion is allowed, the photo morphs between the row and its
    // dialog. The invoker command is held, and the transition opens or closes the dialog while one view-transition-name
    // moves from one image to the other (https://developer.mozilla.org/en-US/docs/Web/API/Document/startViewTransition).
    // Elsewhere the command runs natively.
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const canMorph = () =>
      "startViewTransition" in document && !reducedMotion.matches;
    const morph = async (
      from: HTMLElement,
      to: HTMLElement,
      update: () => void,
    ) => {
      from.style.viewTransitionName = "photo";
      const transition = document.startViewTransition(() => {
        from.style.viewTransitionName = "";
        to.style.viewTransitionName = "photo";
        update();
      });
      await transition.finished;
      to.style.viewTransitionName = "";
    };
    for (const dialog of row.querySelectorAll("dialog")) {
      const thumb = dialog.parentElement?.querySelector("img") ?? null;
      const large = dialog.querySelector("img");
      if (thumb === null || large === null) continue;
      const close = () => morph(large, thumb, () => dialog.close());
      // The large image loads on open; the morph waits for it, so it does not fly in empty.
      const open = async () => {
        large.loading = "eager";
        await large.decode().catch(() => undefined);
        await morph(thumb, large, () => dialog.showModal());
      };
      // Only the photo's show-modal and the close button's close target the dialog. While it is open the page behind it
      // is inert, so neither command arrives in the wrong state.
      dialog.addEventListener("command", (event) => {
        if (!(event instanceof CommandEvent) || !canMorph()) return;
        event.preventDefault();
        void (event.command === "show-modal" ? open() : close());
      });
      // Esc and a click outside fire cancel before the dialog closes.
      dialog.addEventListener("cancel", (event) => {
        if (!canMorph()) return;
        event.preventDefault();
        void close();
      });
    }
  }
</script>

<style>
  /* Full bleed, tilted like prints on a table, with snap points. No scrollbar: the last photo peeking past the
     edge and the grab cursor show that it scrolls. The scroller clips what overflows it, so the end padding is as
     deep as the tile's shadow. */
  .photos {
    margin-inline: var(--size-bleed);
    padding-block: var(--space-8) var(--space-12);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .photos[data-draggable] {
    cursor: grab;
  }
  /* Snapping waits for the release, so the row follows the mouse; when it returns, the row snaps to the nearest photo
     (https://drafts.csswg.org/css-scroll-snap-1/#re-snap). */
  .photos[data-dragging] {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }
  ul {
    display: flex;
    gap: var(--space-6);
    inline-size: max-content;
    margin: 0 auto;
    padding: 0 var(--space-6);
    list-style: none;
  }
  /* A fixed size and aspect ratio reserve the box before anything loads, so the row does not shift. The gradient shows
     until a photo has loaded. */
  .photo {
    display: block;
    inline-size: var(--size-photo);
    block-size: auto;
    aspect-ratio: 9 / 10;
    object-fit: cover;
    scroll-snap-align: center;
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-raised);
    background-image: linear-gradient(160deg, var(--accent-a), var(--accent-b));
  }
  li:nth-child(1) .photo {
    rotate: 2deg;
  }
  li:nth-child(2) .photo {
    rotate: -2deg;
  }
  li:nth-child(3) .photo {
    rotate: 1.5deg;
  }
  li:nth-child(4) .photo {
    rotate: -1.5deg;
  }
  li:nth-child(5) .photo {
    rotate: 2.5deg;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .photo {
      transition:
        rotate var(--duration-enter) var(--ease-spring),
        scale var(--duration-enter) var(--ease-spring);
    }
    li .photo:hover {
      rotate: 0deg;
      scale: 1.04;
    }
  }

  /* The photo is a button that opens its dialog. The focus ring follows the photo's corners. */
  .open {
    display: block;
    padding: 0;
    border: none;
    border-radius: var(--radius-2xl);
    background: none;
    cursor: zoom-in;
  }
  .photos[data-dragging] .open {
    cursor: inherit;
  }

  /* The open photo on a raised surface with the card shadow, over a dimmed page. */
  .viewer {
    padding: var(--space-4);
    border: none;
    border-radius: var(--radius-2xl);
    max-inline-size: calc(100% - 2 * var(--space-4));
    max-block-size: calc(100% - 2 * var(--space-4));
    overflow: auto;
    background-color: var(--theme-secondary);
    color: var(--font-color);
    box-shadow: var(--shadow-card-edge), var(--shadow-raised);
  }
  .viewer[open] {
    display: grid;
    justify-items: end;
    gap: var(--space-2);
  }
  .viewer::backdrop {
    background-color: var(--backdrop-color);
  }
  figure {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }
  .large {
    display: block;
    block-size: var(--size-photo-large);
    inline-size: auto;
    aspect-ratio: 9 / 10;
    object-fit: cover;
    border-radius: var(--radius-xl);
  }
  /* A zero inline size with a 100% minimum keeps a long caption from widening the figure past the photo. */
  figcaption {
    inline-size: 0;
    min-inline-size: 100%;
    text-align: center;
  }

  /* Without the morph the dialog fades in (https://developer.mozilla.org/en-US/docs/Web/CSS/@starting-style). */
  @media (prefers-reduced-motion: no-preference) {
    .viewer[open] {
      transition: opacity var(--duration-3) ease-out;
    }
    @starting-style {
      .viewer[open] {
        opacity: 0;
      }
    }
  }
  /* The morph: the photo's group moves and resizes from the row to the dialog and back. */
  :global(::view-transition-group(photo)) {
    animation-duration: var(--duration-4);
    animation-timing-function: var(--ease-in-out-strong);
  }
</style>
