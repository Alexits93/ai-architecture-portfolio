---
// Page-only component for the home page (ADR 002): a full-width row of tilted photos under the hero (#255, direction C
// on #252, from the Mitrakos reference), with the owner's photos (#261).
import { Image } from 'astro:assets';
import balloon from '@/assets/photos/row-1-balloon.jpg';
import stadium from '@/assets/photos/row-2-stadium.jpg';
import seoul from '@/assets/photos/row-3-seoul.jpg';
import porsche from '@/assets/photos/row-4-porsche.jpg';
import alpinePass from '@/assets/photos/row-5-alpine-pass.jpg';

const photos = [
	{ src: balloon, alt: 'My wife and me at The ICE festival in St. Moritz, Switzerland' },
	{ src: stadium, alt: 'In the Santiago Bernabéu stadium in Madrid, Spain. Hala Madrid!' },
	{ src: seoul, alt: 'My wife in a hanbok, seen from behind, in front of a Korean pagoda' },
	{ src: porsche, alt: 'Sitting in my dream Porsche, a 911 930 Turbo Slant Nose' },
	{ src: alpinePass, alt: 'My wife and me on the Gotthard Pass, Switzerland' },
];
---

<!-- The row scrolls where it overflows. tabindex lets keyboard users scroll it: WebKit does not focus a scroller on its
     own (axe scrollable-region-focusable). The focusable row needs a role and a name; a group, not a region landmark,
     because Orca 51's next-landmark command loops on a landmark whose first content is an image (#304, #261). -->
<div id="photos" class="photos" role="group" aria-label="Photos" tabindex="0">
	<ul>
		{/* Below the fold, so Astro's default loading="lazy" applies. The widths cover --size-photo up to 3x. draggable="false"
		    stops the browser's native image drag, which would cancel the row's mouse drag. */}
		{photos.map(({ src, alt }) => <li><Image class="photo" src={src} alt={alt} widths={[200, 400, 600, 816]} sizes="clamp(12rem, 22vw, 17rem)" quality={70} draggable="false" /></li>)}
	</ul>
</div>

<script>
	// Touch, the wheel and the keyboard scroll the row natively; a mouse drag does not, so this script adds it (#279).
	// Pointer capture keeps the drag going when the mouse leaves the row
	// (https://developer.mozilla.org/en-US/docs/Web/API/Element/setPointerCapture).
	const row = document.getElementById('photos');
	if (row !== null) {
		// The grab cursor shows only where the row overflows and there is something to drag.
		new ResizeObserver(() => row.toggleAttribute('data-draggable', row.scrollWidth > row.clientWidth)).observe(row);
		// The row starts at its middle, so both outer photos sit partly off screen. A scroller starts at its left edge,
		// and scroll-initial-target, which could pick the middle photo in CSS, ships in Chromium only
		// (https://developer.mozilla.org/en-US/docs/Web/CSS/scroll-initial-target).
		row.scrollLeft = (row.scrollWidth - row.clientWidth) / 2;
		let startX = 0;
		let startScroll = 0;
		row.addEventListener('pointerdown', (event) => {
			if (event.pointerType !== 'mouse' || event.button !== 0 || !row.hasAttribute('data-draggable')) return;
			row.setPointerCapture(event.pointerId);
			startX = event.clientX;
			startScroll = row.scrollLeft;
			row.toggleAttribute('data-dragging', true);
		});
		row.addEventListener('pointermove', (event) => {
			if (row.hasPointerCapture(event.pointerId)) row.scrollLeft = startScroll - (event.clientX - startX);
		});
		row.addEventListener('lostpointercapture', () => row.toggleAttribute('data-dragging', false));
	}
</script>

<style>
	/* Full bleed, tilted like prints on a table, with snap points. No scrollbar (#279): the last photo peeking past the
	   edge and the grab cursor show that it scrolls. The scroller clips what overflows it, so the end padding is as
	   deep as the tile's shadow. */
	.photos {
		margin-inline: var(--size-bleed); padding-block: var(--space-8) var(--space-12);
		overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
	}
	.photos[data-draggable] { cursor: grab; }
	/* Snapping waits for the release, so the row follows the mouse; when it returns, the row snaps to the nearest photo
	   (https://drafts.csswg.org/css-scroll-snap-1/#re-snap). */
	.photos[data-dragging] { cursor: grabbing; scroll-snap-type: none; user-select: none; }
	ul {
		display: flex; gap: var(--space-6); inline-size: max-content;
		margin: 0 auto; padding: 0 var(--space-6); list-style: none;
	}
	/* A fixed size and aspect ratio reserve the box before anything loads, so the row does not shift. The gradient shows
	   until a photo has loaded. */
	.photo {
		display: block; inline-size: var(--size-photo); block-size: auto; aspect-ratio: 9 / 10; object-fit: cover;
		scroll-snap-align: center; border-radius: var(--radius-2xl); box-shadow: var(--shadow-raised);
		background-image: linear-gradient(160deg, var(--accent-a), var(--accent-b));
	}
	li:nth-child(1) .photo { rotate: 2deg; }
	li:nth-child(2) .photo { rotate: -2deg; }
	li:nth-child(3) .photo { rotate: 1.5deg; }
	li:nth-child(4) .photo { rotate: -1.5deg; }
	li:nth-child(5) .photo { rotate: 2.5deg; }
	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.photo { transition: rotate var(--duration-enter) var(--ease-spring), scale var(--duration-enter) var(--ease-spring); }
		li .photo:hover { rotate: 0deg; scale: 1.04; }
	}
</style>
