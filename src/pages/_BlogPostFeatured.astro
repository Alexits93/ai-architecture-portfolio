---
import { getCollection } from 'astro:content';
import BlogPostThumbnail from '@/components/BlogPostThumbnail.astro';
import { selectFeaturedPost } from '@/lib/posts';

const featuredPost = selectFeaturedPost(await getCollection('blog'));
---
<section id="blog-featured">
  <div class="wrapper">
    <h1>Featured Article</h1>
    {featuredPost && <BlogPostThumbnail post={featuredPost} />}
  </div>
</section>

<style>
  #blog-featured {
    width: 100%;
  }
  
  #blog-featured .wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, var(--size-card-max)));
    gap: var(--space-4);
    justify-content: center;
  }
  
  #blog-featured .wrapper h1 {
    color: var(--font-color-bold);
    text-align: center;
    margin: 0;
    letter-spacing: var(--letter-spacing-tight);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-2xl);
    line-height: var(--line-height-xl);
  }
  

  @media (min-width: 48rem) {
    #blog-featured .wrapper {
      justify-content: flex-start;
    }
  
    #blog-featured .wrapper h1 {
      text-align: left;
    }
  }
  
  @media (min-width: 64rem) {
    #blog-featured .wrapper {
      justify-content: flex-end;
    }
  }
</style>
