---
import type { Page } from 'astro';
import { BlogPostThumbnail, getCategoryPath, type BlogPost, type Category } from '@/entities/blog-post';
import { CATEGORIES } from '@/content.config';
import { ROUTES } from '@/shared/config';

interface Props {
	heading: string;
	/** One page of newest-first posts from paginate() (https://docs.astro.build/en/reference/routing-reference/#page-prop). */
	page: Page<BlogPost>;
	/** The category page being rendered; undefined on /blog/. */
	current?: Category;
}

const { heading, page, current } = Astro.props;
const links = [
	{ name: 'All', href: ROUTES.blog, isCurrent: current === undefined },
	...CATEGORIES.map((category) => ({ name: category, href: getCategoryPath(category), isCurrent: category === current })),
];
---

<div class="blog-feed-container">
	<h1>{heading}</h1>
	<nav aria-label="Blog categories">
		<ul>
			{links.map(({ name, href, isCurrent }) => (
				<li><a href={href} aria-current={isCurrent ? 'page' : undefined}>{name}</a></li>
			))}
		</ul>
	</nav>
	<div class="blog-grid">
		{page.data.map((post) => (
			<div class="blog-post-wrapper">
				<BlogPostThumbnail post={post} />
			</div>
		))}
	</div>
	{page.lastPage > 1 && (
		<nav aria-label="Pagination" class="pagination">
			{page.url.prev && <a href={page.url.prev} rel="prev">Previous</a>}
			<a href={page.url.current} aria-current="page">Page {page.currentPage} of {page.lastPage}</a>
			{page.url.next && <a href={page.url.next} rel="next">Next</a>}
		</nav>
	)}
</div>

<style>
	.blog-feed-container {
		max-width: var(--page-max-width, 1200px);
		margin: 0 auto;
		padding: 2rem 1rem;
	}

	h1 {
		text-align: center;
		margin-bottom: 2rem;
		font-size: 2.5rem;
		color: var(--font-color);
	}

	nav ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: .5rem 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	nav a {
		color: var(--font-color);
	}

	.pagination {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
		margin-top: 2rem;
	}

	nav a[aria-current='page'] {
		color: var(--font-color-bold);
		font-weight: 700;
		text-decoration: none;
	}

	/* A bare 1fr has an automatic minimum (minmax(auto, 1fr), CSS Grid 2 fr unit), so a wide child
	   can widen the track past a small viewport in any engine. minmax(0, 1fr) lets it shrink. */
	.blog-grid {
		display: grid;
		gap: 2rem;
		grid-template-columns: minmax(0, 1fr);
		margin-top: 2rem;
	}

	@media (min-width: 768px) {
		.blog-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.blog-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.blog-post-wrapper {
		display: flex;
		height: 100%;
	}
</style>
