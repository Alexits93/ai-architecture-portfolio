---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import { CATEGORIES } from "@/content.config";
import { categoriesWithPosts, sortByNewest } from "@/lib/posts";
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogFeed from "./_BlogFeed.astro";

// 10 posts per page. The rest parameter puts page 1 at /blog/ and page 2 at /blog/2/
// (https://docs.astro.build/en/reference/routing-reference/#paginate, Astro 7).
export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("blog");
  return paginate(sortByNewest(posts), {
    pageSize: 10,
    props: { categories: categoriesWithPosts(CATEGORIES, posts) },
  });
}) satisfies GetStaticPaths;

const { categories, page } = Astro.props;
import { SITE } from "@/consts";
---

<BaseLayout
  title={`Blog | ${SITE.name}`}
  description="Articles on frontend architecture, LLM coding agents and software engineering."
>
  <main>
    <BlogFeed text="All" accent="posts" page={page} categories={categories} />
  </main>
</BaseLayout>
