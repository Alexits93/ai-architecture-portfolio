---
import { getCollection } from 'astro:content';
import { CATEGORIES } from '@/content.config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogFeed from '../_BlogFeed.astro';

// One static page per category (https://docs.astro.build/en/guides/routing/, getStaticPaths).
export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return CATEGORIES.map((category) => ({
		params: { category: category.toLowerCase() },
		props: { category, posts: posts.filter((post) => post.data.category === category) },
	}));
}

const { category, posts } = Astro.props;
---

<BaseLayout title={`${category} | Blog | Patrik Alexits`} description={`Articles by Patrik Alexits in the ${category} category.`}>
	<main>
		<BlogFeed heading={`Blog: ${category}`} posts={posts} current={category} />
	</main>
</BaseLayout>
