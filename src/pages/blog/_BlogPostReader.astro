---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import ArticleNavigator from "./_ArticleNavigator.astro";
import DisplayHeading from "@/components/DisplayHeading.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import { SITE } from "@/consts";
import { displayDate, isoDate } from "@/lib/dates";
import { getCategoryPath } from "@/lib/permalink";
import Logo from "@/assets/logo.svg";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<div class="blog-post-layout">
  <div class="blog-post-reader">
    <header class="wrapper-top" id="post-hero">
      {/* The subtitle belongs to the title, so it is a paragraph in the hgroup, not a second heading. */}
      <hgroup>
        <Eyebrow>
          <a href={getCategoryPath(post.data.category)}>
            {post.data.category}
          </a>{" "}
        </Eyebrow>
        <DisplayHeading
          as="h1"
          size="section"
          data-morph="title"
          text={post.data.title}
        />
        <p class="subtitle">{post.data.subtitle}</p>
      </hgroup>
      <div class="wrapper-top-post-data">
        <div class="author-info">
          <Logo width="63.54" height="40" aria-hidden="true" />
          <p>{SITE.name}</p>
        </div>
        <p>
          <time datetime={isoDate(post.data.publishDate)}>
            {displayDate(post.data.publishDate, "short")}
          </time>
        </p>
      </div>
    </header>

    <article class="prose">
      <Content />
    </article>
  </div>

  {/* A layout column, not a landmark: the nav inside carries the name. */}
  <div class="navigator-sidebar">
    <ArticleNavigator headings={headings} />
  </div>
</div>

<style>
  .blog-post-layout {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0 auto;
  }

  .blog-post-reader {
    max-width: 100%;
    width: 100%;
  }

  .navigator-sidebar {
    display: none;
  }

  .subtitle {
    margin: var(--space-4) 0 var(--space-6);
    color: var(--font-color);
    font-size: var(--font-size-xl);
    line-height: var(--line-height-lg);
  }

  .wrapper-top-post-data {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) 0;
    margin-bottom: var(--space-4);
    border-block: var(--border-width-hairline) solid var(--hairline-color);
  }

  .author-info {
    display: flex;
    flex-direction: row;
    gap: var(--space-2);
    align-items: center;
  }

  .author-info svg {
    height: var(--size-icon-md);
  }

  /* Lines stay under 80 characters (WCAG 1.4.8,
     https://www.w3.org/WAI/WCAG22/Understanding/visual-presentation.html). */
  .prose {
    max-inline-size: 70ch;
    line-height: var(--line-height-body);
    margin-bottom: var(--space-8);
  }

  /* The global reset zeroes the margins of p, li and headings, so each block and list item gets its gap back here,
     or the text reads as one wall. A heading sits closer to its own text than to the section above it. */
  .prose > :global(* + *) {
    margin-block-start: var(--space-6);
  }

  .prose :global(li + li) {
    margin-block-start: var(--space-2);
  }

  .prose :global(strong) {
    color: var(--font-color-bold);
  }

  /* A topic (h2) groups points (h3): both are larger than body text, the topic more so, with more space above. */
  .prose :global(:is(h2, h3)) {
    margin: 0;
    font-weight: var(--font-weight-bold);
    color: var(--font-color-bold);
    letter-spacing: var(--letter-spacing-tight);
  }

  .prose :global(h2) {
    font-size: var(--font-size-2xl);
    line-height: var(--line-height-display-card);
  }

  .prose :global(h3) {
    font-size: var(--font-size-xl);
    line-height: var(--line-height-lg);
  }

  .prose > :global(* + h2) {
    margin-block-start: var(--space-16);
  }

  .prose > :global(* + h3) {
    margin-block-start: var(--space-10);
  }

  .prose > :global(h2 + *) {
    margin-block-start: var(--space-4);
  }

  .prose > :global(h3 + *) {
    margin-block-start: var(--space-2);
  }

  /* Prism token classes from markdown.syntaxHighlight: 'prism'. Markdown output carries no scope attribute, hence :global(). */
  .prose :global(pre) {
    overflow-x: auto;
    margin: 0 0 var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background-color: var(--theme-secondary);
    font-size: var(--font-size-sm);
    line-height: 1.5;
  }

  .prose :global(code) {
    font-family: var(--font-family-mono);
  }

  .prose :global(:not(pre) > code) {
    padding: 0.125rem var(--space-1);
    border-radius: var(--radius-sm);
    background-color: var(--theme-secondary);
    font-size: 0.875em;
  }

  .prose
    :global(:is(.token.comment, .token.prolog, .token.doctype, .token.cdata)) {
    color: var(--code-comment);
    font-style: italic;
  }

  .prose
    :global(
      :is(
        .token.keyword,
        .token.atrule,
        .token.important,
        .token.selector,
        .token.tag
      )
    ) {
    color: var(--code-keyword);
  }

  .prose
    :global(
      :is(
        .token.string,
        .token.char,
        .token.attr-value,
        .token.regex,
        .token.url,
        .token.inserted
      )
    ) {
    color: var(--code-string);
  }

  .prose
    :global(
      :is(
        .token.number,
        .token.boolean,
        .token.constant,
        .token.symbol,
        .token.deleted
      )
    ) {
    color: var(--code-number);
  }

  .prose
    :global(
      :is(
        .token.function,
        .token.class-name,
        .token.builtin,
        .token.attr-name,
        .token.property
      )
    ) {
    color: var(--code-function);
  }

  @media (min-width: 64rem) {
    .blog-post-layout {
      display: grid;
      grid-template-columns: 1fr var(--size-sidebar);
      gap: var(--space-12);
      width: 100%;
      margin: 0;
    }

    .navigator-sidebar {
      display: block;
      position: sticky;
      top: var(--space-24);
      height: max-content;
    }
  }
</style>
