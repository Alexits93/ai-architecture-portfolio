---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Footer } from '@/widgets/footer';
import { BlogPostRecommended } from '@/widgets/blog-post-recommended';
import BlogPostReader from '@/widgets/blog-post-reader/ui/BlogPostReader.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<BaseLayout title={`${post.data.title} | Patrik Alexits`} description={post.data.description} type="article">
	<main>
		<BlogPostReader post={post} />
		<BlogPostRecommended />
	</main>

	<Footer />
</BaseLayout>
