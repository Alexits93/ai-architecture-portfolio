---
import { getCollection } from 'astro:content';
import { Header } from '@/widgets/header';
import { NavigatorMenu } from '@/widgets/navigator-menu';
import { Footer } from '@/widgets/footer';
import { BlogPostRecommended } from '@/widgets/blog-post-recommended';
import BlogPostReader from '@/widgets/blog-post-reader/ui/BlogPostReader.astro';
import SeoHead from '@/shared/ui/seo-head/SeoHead.astro';
import '@/shared/styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
import { ClientRouter } from 'astro:transitions';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="manifest" href="/site.webmanifest">
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
        
        <SeoHead
            title={`${post.data.title} - Patrik Alexits`}
            description={post.data.description}
            ogType="article"
        />
		<ClientRouter />
	</head>
	<body>
        <Header />
		<NavigatorMenu />
        
        <main>
            <BlogPostReader post={post} />
            <BlogPostRecommended />
        </main>

        <Footer />
	</body>
</html>
