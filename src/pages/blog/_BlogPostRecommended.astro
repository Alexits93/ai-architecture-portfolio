---
// Page-only component for the post pages (ADR 002): the recommended posts under an article.
import { getCollection } from 'astro:content';
import BlogPostThumbnail from '@/components/BlogPostThumbnail.astro';
import DisplayHeading from '@/components/DisplayHeading.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Pill from '@/components/Pill.astro';
import { selectRecommendedPosts } from '@/lib/posts';
import { ROUTES } from '@/consts';

interface Props {
  /** Post to omit, e.g. the article currently being read. */
  excludeId?: string;
}

const { excludeId } = Astro.props;
const recommendedPosts = selectRecommendedPosts(await getCollection('blog'), { excludeId });
---
<!-- The head of the home Writing section: eyebrow, display title, and the All posts pill (#300). -->
<section id="blog-section" aria-labelledby="recommended-title">
  <div class="head">
    <div>
      <Eyebrow>Blog</Eyebrow>
      <DisplayHeading as="h2" size="section" id="recommended-title" text="Recommended" accent="articles" />
    </div>
    <Pill href={ROUTES.blog}>All posts</Pill>
  </div>
  <div class="wrapper">
    {recommendedPosts.map(post => (
      <BlogPostThumbnail post={post} heading="h3" />
    ))}
  </div>
</section>

<style>
  #blog-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    width: 100%;
    padding-block: var(--space-12);
  }

  #blog-section .head { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: var(--space-4); }

  #blog-section .wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, var(--size-card-max)));
    gap: var(--space-8);
    justify-content: center;
  }

  /* Cards rise into place as they scroll into view. Only where scroll timelines exist and motion is allowed;
     elsewhere they are static (#210, MDN animation-timeline view()). Longhands only, and not all of them: the CSS
     minifier folds a complete set into the animation shorthand, and Chromium rejects view() inside that shorthand. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      #blog-section .wrapper > :global(.blog-post-thumbnail) {
        animation-name: card-reveal;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: var(--range-reveal);
      }
    }
  }

  @keyframes card-reveal {
    from {
      opacity: 0;
      translate: 0 var(--space-12);
      scale: .94;
    }
  }

  @media (min-width: 48rem) {
    #blog-section .wrapper {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 80rem) {
    #blog-section .wrapper {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
