---
import LegalLayout from "@/layouts/LegalLayout.astro";
import { ROUTES } from "@/consts";
---

<LegalLayout
  text="Cookie"
  accent="Disclaimer"
  description="pa-tech.dev sets no cookies. It stores only your light or dark theme choice, in your browser's localStorage, and never sends it to a server."
>
  <p>This site sets no cookies and embeds no third-party content.</p>

  <h2>Theme setting</h2>
  <p>
    When you switch between the light and dark theme, your browser stores that
    choice under the key "theme" in localStorage. It stays on your device and is
    never sent to a server. Clearing the site data in your browser removes it.
  </p>

  <p>
    For how I handle data, read the{" "}
    <a href={ROUTES.privacyPolicy}>Privacy Policy.</a>
  </p>
</LegalLayout>
