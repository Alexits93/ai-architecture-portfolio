---
// Page-only component for /cv/ (ADR 002): the name, the role, the about text and the social links.
import GitHubIcon from "@/assets/github.svg";
import LinkedInIcon from "@/assets/linkedin.svg";
import InstagramIcon from "@/assets/instagram.svg";
import StackOverflowIcon from "@/assets/stackoverflow.svg";
import DisplayHeading from "@/components/DisplayHeading.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import { SITE, SOCIAL_LINKS } from "@/consts";

// Instagram, the only non-work profile, comes last.
const socials = [
  { name: "GitHub", url: SOCIAL_LINKS.github, Icon: GitHubIcon },
  { name: "LinkedIn", url: SOCIAL_LINKS.linkedin, Icon: LinkedInIcon },
  { name: "Stack Overflow", url: SOCIAL_LINKS.stackoverflow, Icon: StackOverflowIcon },
  { name: "Instagram", url: SOCIAL_LINKS.instagram, Icon: InstagramIcon },
];
---

<section id="about-me" class="about-me">
  <article>
    <div class="introduction-wrapper">
      <Eyebrow>CV</Eyebrow>
      {/* The role belongs to the name, so it is a paragraph in the hgroup and "About" is the next h2. */}
      <hgroup>
        <DisplayHeading as="h1" size="section" text={SITE.name} />
        <p class="role">{SITE.role}</p>
      </hgroup>
    </div>
    <div class="about-wrapper">
      <h2>About</h2>
      <div>
        <p>Bringing 7+ years of experience in web development with an emphasis on front-end technologies. Expert in enhancing user interfaces and ensuring accessibility, delivering projects that consistently meet rigorous web standards.</p>
        <ul class="social-links">
          {socials.map(({ name, url, Icon }) => (
            <li>
              <a href={url}>
                <Icon width="25" height="25" aria-hidden="true" />
                <span class="sr-only">{name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </article>
</section>

<style>
  .about-me article .introduction-wrapper h1 {
    margin: 0 0 var(--space-4);
  }

  .about-me article .introduction-wrapper .role {
    color: var(--font-color-bold);
    margin: 0 0 var(--space-4);
    letter-spacing: var(--letter-spacing-tight);
    font-weight: var(--font-weight-medium);
    font-size: var(--font-size-xl);
    line-height: var(--line-height-lg);
  }

  .about-me article .about-wrapper h2 {
    color: var(--font-color-bold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-sm);
    margin: var(--space-8) 0 var(--space-2);
  }

  .about-me article .about-wrapper p {
    color: var(--font-color);
    margin: 0 0 var(--space-4);
  }

  .about-me article .about-wrapper div .social-links {
    padding-left: 0;
    margin: 0;
  }

  .about-me article .about-wrapper div .social-links li {
    list-style: none;
    display: inline-block;
    margin-right: var(--space-4);
  }

  .about-me article .about-wrapper div .social-links li:last-of-type {
    margin-right: 0;
  }

  .about-me article .about-wrapper div .social-links li a {
    display: flex;
    align-items: center;
    color: var(--font-color);
  }

  .about-me article .about-wrapper div .social-links li a:hover {
    color: var(--focus-color);
  }

  .about-me article .about-wrapper div .social-links li a svg {
    width: var(--size-icon-sm);
    height: var(--size-icon-sm);
    transition: color var(--duration-3);
  }

  .about-me h1,
  .about-me .role {
    text-wrap: balance;
  }

  /* The name is painted by a gradient between two accents; --name-accent is a registered colour, so it can move.
     fit-content makes the gradient span the name, not the whole column. */
  .about-me article .introduction-wrapper h1 {
    --name-accent: var(--accent-b);
    width: fit-content;
    background-image: linear-gradient(100deg, var(--accent-a), var(--name-accent), var(--accent-b));
    background-clip: text;
    color: transparent;
  }

  /* Motion only when the visitor allows it; without it every part shows in its final state. */
  @media (prefers-reduced-motion: no-preference) {
    .about-me .introduction-wrapper > :global(.eyebrow),
    .about-me h1,
    .about-me .role,
    .about-me h2,
    .about-me p,
    .about-me .social-links {
      animation: hero-enter var(--duration-enter) var(--ease-spring) both;
      animation-delay: calc(var(--hero-step) * var(--stagger));
    }

    .about-me h1 { --hero-step: 0; }
    .about-me p { --hero-step: 3; }
    .about-me .role { --hero-step: 1; }
    .about-me h2 { --hero-step: 2; }
    .about-me .social-links { --hero-step: 4; }

    .about-me article .introduction-wrapper h1 {
      animation:
        hero-enter var(--duration-enter) var(--ease-spring) both,
        name-gradient var(--duration-drift) ease-in-out infinite alternate;
      animation-delay: 0s, var(--duration-enter);
    }
  }
</style>
