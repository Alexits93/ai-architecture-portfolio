---
import { getCollection } from 'astro:content';
import { formatPeriod, sortByStartDesc, splitEmphasis } from '@/lib/experience';
import SkillTag from './_SkillTag.astro';

const entries = sortByStartDesc(await getCollection('experience'));
---

<div class="experience-list-container">
    <h2>Experience</h2>
    {entries.map(({ data }) => (
        <article class="experience-item">
            <span>{formatPeriod(data)}</span>
            <div class="position">
                <h3>{data.role} - {data.company}</h3>
                {data.highlights.map((highlight) => (
                    <p>{splitEmphasis(highlight, data.emphasis).map((part) => (part.strong ? <strong>{part.text}</strong> : part.text))}</p>
                ))}
                <div class="tags">
                    {data.skills.map((skill) => <SkillTag skill={skill} />)}
                </div>
            </div>
        </article>
    ))}
</div>

<style>
    .experience-list-container { display: flex; flex-direction: column; gap: var(--space-4); }
    .experience-list-container .experience-item {
        padding: var(--space-4); border-radius: var(--radius-lg);
        filter: var(--shadow-card);
        box-shadow: var(--shadow-card-edge);
        background-color: var(--theme-secondary); color: var(--font-color);
    }
    .experience-list-container .experience-item .position p strong { color: var(--font-color-bold); }
    .experience-list-container .experience-item .position p strong:hover { background-color: var(--theme-primary); color: var(--focus-color); }

    .experience-list-container .position h3 { margin: 0 0 var(--space-4); color: var(--font-color-bold); }
    .experience-list-container .position .tags { display: flex; gap: var(--space-1) var(--space-2); flex-wrap: wrap; margin: var(--space-4) 0; }
    .experience-list-container h2 { margin: 0 0 var(--space-4); color: var(--font-color-bold); }
</style>
