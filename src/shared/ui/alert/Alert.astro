---
export interface Props {
	type?: 'success' | 'info' | 'warning' | 'error';
	text: string;
	dismissible?: boolean;
	duration?: number;
}

const {
	type = 'success',
	text,
	dismissible = false,
	duration = 8000,
} = Astro.props;

const headerText = {
	success: 'Success',
	info: 'Info',
	warning: 'Warning',
	error: 'Error',
}[type];

const iconId = {
	success: '#check-circle-fill',
	info: '#info-fill',
	warning: '#exclamation-triangle-fill',
	error: '#exclamation-triangle-fill',
}[type];

const animationDurationSeconds = duration / 1000;
---

<ui-alert class="alert-wrapper" data-dismissible={String(dismissible)} data-duration={duration}>
	<svg xmlns="http://www.w3.org/2000/svg" class="svg-source" aria-hidden="true" style="display: none;">
		<symbol id="check-circle-fill" viewBox="0 0 16 16">
			<path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
		</symbol>
		<symbol id="info-fill" viewBox="0 0 16 16">
			<path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
		</symbol>
		<symbol id="exclamation-triangle-fill" viewBox="0 0 16 16">
			<path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
		</symbol>
	</svg>

	<div class={`notification ${type}`} role="alert">
		<div class="notification-header">
			<svg role="img" aria-label={`${headerText}:`}><use href={iconId}></use></svg>
			<h4>{headerText}</h4>
		</div>
		<div class="notification-body">
			<p>{text}</p>
		</div>
		{dismissible && (
			<div class="notification-footer" style={`animation-duration: ${animationDurationSeconds}s;`}></div>
		)}
	</div>
</ui-alert>

<style>
	.alert-wrapper {
		--host-bg-color-success: #051b11;
		--host-bg-color-info: #084298;
		--host-bg-color-warning: #332701;
		--host-bg-color-error: #2c0b0e;

		--host-font-color-success: #75b798;
		--host-font-color-info: #6ea8fe;
		--host-font-color-warning: #ffda6a;
		--host-font-color-error: #ea868f;

		--host-border-color-success: #75b798;
		--host-border-color-info: #6ea8fe;
		--host-border-color-warning: #ffda6a;
		--host-border-color-error: #ea868f;

		cursor: pointer;
		position: fixed;
		top: 1rem;
		right: 1rem;
		z-index: 9999;
		transform: translateX(calc(100% + 1rem));
		animation: show .75s ease-in-out forwards;
	}

	.notification {
		min-width: 200px;
		max-width: 400px;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
		border-radius: 10px;
		border-width: 1px;
		border-style: solid;
	}

	.notification.success {
		background: var(--host-bg-color-success);
		color: var(--host-font-color-success);
		border-color: var(--host-border-color-success);
	}

	.notification.info {
		background: var(--host-bg-color-info);
		color: var(--host-font-color-info);
		border-color: var(--host-border-color-info);
	}

	.notification.warning {
		background: var(--host-bg-color-warning);
		color: var(--host-font-color-warning);
		border-color: var(--host-border-color-warning);
	}

	.notification.error {
		background: var(--host-bg-color-error);
		color: var(--host-font-color-error);
		border-color: var(--host-border-color-error);
	}

	.notification-header {
		padding: 1rem 1rem 0;
		display: flex;
		align-items: center;
	}

	.notification-header svg {
		width: 1em;
		height: 1em;
		fill: currentColor;
		margin-right: .5rem;
		flex-shrink: 0;
	}

	.notification-header h4 {
		margin: 0;
	}

	.notification-body {
		padding: 0 1rem 1rem;
	}

	.notification-body p {
		margin: 0;
	}

	.notification-footer {
		height: .20rem;
		width: 0;
	}

	.notification.success .notification-footer { background-color: var(--host-border-color-success); }
	.notification.info .notification-footer { background-color: var(--host-border-color-info); }
	.notification.warning .notification-footer { background-color: var(--host-border-color-warning); }
	.notification.error .notification-footer { background-color: var(--host-border-color-error); }

	.notification-footer {
		animation-name: dismiss;
		animation-timing-function: ease-in-out;
		animation-fill-mode: forwards;
	}

	@keyframes dismiss {
		0% { width: 100%; }
		25% { width: 75%; }
		50% { width: 50%; }
		75% { width: 25%; }
		100% { width: 0px; }
	}

	@keyframes show {
		0% { transform: translateX(100%); }
		100% { transform: translateX(0); }
	}
</style>

<script>
	class UIAlert extends HTMLElement {
		private timeoutId?: number;

		connectedCallback() {
			this.addEventListener('click', this.close.bind(this));

			const isDismissible = this.dataset.dismissible === 'true';
			if (isDismissible) {
				const duration = Number(this.dataset.duration) || 8000;
				this.timeoutId = window.setTimeout(() => {
					this.close();
				}, duration);
			}
		}

		disconnectedCallback() {
			if (this.timeoutId) {
				window.clearTimeout(this.timeoutId);
			}
			this.removeEventListener('click', this.close.bind(this));
		}

		private close() {
			this.remove();
		}
	}

	if (!customElements.get('ui-alert')) {
		customElements.define('ui-alert', UIAlert);
	}
</script>
