---
interface Props {
  skill?: string;
  interactive?: boolean;
  active?: boolean;
}

const {
  skill = "404 - Skill not found",
  interactive = false,
  active = false,
} = Astro.props;

const tagContent = interactive ? skill : `#${skill.toLocaleLowerCase()}`;
---

{interactive ? (
  <button 
    type="button" 
    class:list={['skill-tag', 'interactive', { active }]} 
    aria-pressed={active ? "true" : "false"}
    data-skill={skill}
  >
    {tagContent}
  </button>
) : (
  <span class="skill-tag non-interactive">
    {tagContent}
  </span>
)}

<style>
  .skill-tag {
    display: inline-block;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  /* Interactive Tag (Filter Pill) */
  button.skill-tag.interactive {
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    background-color: var(--theme-secondary);
    color: var(--font-color);
    border: none;
    cursor: pointer;
    font-size: 1rem;
    font-family: inherit;
  }

  button.skill-tag.interactive:hover,
  button.skill-tag.interactive:focus-visible {
    background-color: var(--theme-primary);
    color: white;
    outline: none;
  }

  button.skill-tag.interactive.active {
    background-color: var(--theme-primary);
    color: white;
  }

  /* Non-Interactive Tag (Text) */
  span.skill-tag.non-interactive {
    font-size: 1rem;
    padding: 0.25rem;
    font-style: italic;
    color: var(--font-color);
  }

  /* Global selection override just for this tag to mimic legacy behavior */
  .skill-tag::selection {
    background-color: var(--theme-primary);
  }
</style>
