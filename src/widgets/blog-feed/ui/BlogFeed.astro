---
import { getCollection } from 'astro:content';
import { BlogPostFilter } from '@/features/blog-post-filter';
import { BlogPostThumbnail, selectStandardPosts } from '@/entities/blog-post';

const posts = await getCollection('blog');
const standardPosts = selectStandardPosts(posts);

// Extract unique tags
const allTags = new Set<string>();
standardPosts.forEach((post) => {
	post.data.tags.forEach((tag) => allTags.add(tag));
});
const uniqueTags = Array.from(allTags).sort();
---

<blog-feed-interactive>
	<div class="blog-feed-container">
		<h1>Blog</h1>
		<BlogPostFilter tags={uniqueTags} />
		<div class="blog-grid" id="blog-grid">
			{
				standardPosts.map((post) => (
					<div class="blog-post-wrapper" data-tags={post.data.tags.join(',')}>
						<BlogPostThumbnail post={post} />
					</div>
				))
			}
		</div>
	</div>
</blog-feed-interactive>

<script>
	const hideUnmatchedWrappers = (activeTags: string[], wrappers: NodeListOf<Element>) => {
		wrappers.forEach((wrapper) => {
			if (!(wrapper instanceof HTMLElement)) return;

			if (activeTags.length === 0) {
				wrapper.hidden = false;
				return;
			}

			const tagsAttr = wrapper.getAttribute('data-tags');
			const postTags = tagsAttr ? tagsAttr.split(',') : [];
			wrapper.hidden = !activeTags.some((tag) => postTags.includes(tag));
		});
	};

	class BlogFeedInteractive extends HTMLElement {
		connectedCallback() {
			const filter = this.querySelector('.blog-post-filter');
			const grid = this.querySelector('#blog-grid');

			if (!filter || !grid) return;

			filter.addEventListener('change', () => {
				const activeTags = [...filter.querySelectorAll('input')]
					.filter((input) => input.name === 'tag' && input.checked)
					.map((input) => input.value);
				hideUnmatchedWrappers(activeTags, grid.querySelectorAll('.blog-post-wrapper'));
			});
		}
	}

	customElements.define('blog-feed-interactive', BlogFeedInteractive);
</script>

<style>
	/* The filter works only through the script, so it takes its space but stays invisible until
	   the element is defined (MDN :defined); visibility, not display, keeps the grid from shifting. */
	blog-feed-interactive:not(:defined) :global(.blog-post-filter) {
		visibility: hidden;
	}

	.blog-feed-container {
		max-width: var(--page-max-width, 1200px);
		margin: 0 auto;
		padding: 2rem 1rem;
	}

	h1 {
		text-align: center;
		margin-bottom: 2rem;
		font-size: 2.5rem;
		color: var(--font-color);
	}

	.blog-grid {
		display: grid;
		gap: 2rem;
		grid-template-columns: 1fr;
		margin-top: 2rem;
	}

	@media (min-width: 768px) {
		.blog-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.blog-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.blog-post-wrapper {
		display: flex;
		height: 100%;
	}

	.blog-post-wrapper[hidden] {
		display: none;
	}
</style>
