---
interface Props {
  name?: string;
  profession?: string;
  text?: string;
  spotifyTrackId?: string;
  githubUrl?: string;
  linkedinUrl?: string;
  instagramUrl?: string;
  stackoverflowUrl?: string;
}

const {
  name = "John Doe",
  profession = "Jedi Council Member (Not Master though)",
  text = "I don't like sand. It's coarse and rough and irritating — and it gets everywhere.",
  spotifyTrackId = "",
  githubUrl = "",
  linkedinUrl = "",
  instagramUrl = "",
  stackoverflowUrl = ""
} = Astro.props;

// OWASP XSS prevention: Only allow Spotify track IDs, which are alphanumeric.
const isValidSpotifyTrack = /^[a-zA-Z0-9]+$/.test(spotifyTrackId);
const sanitizedSpotifyTrackId = isValidSpotifyTrack ? spotifyTrackId : "";

const hasSocials = Boolean(githubUrl || linkedinUrl || instagramUrl || stackoverflowUrl);
---

<section id="about-me" class="about-me">
  <article>
    <div class="introduction-wrapper">
      <h1>{name}</h1>
      <h2>{profession}</h2>
      {sanitizedSpotifyTrackId && (
        <iframe
          title="Spotify"
          class="spotify-iframe"
          src={`https://open.spotify.com/embed/track/${sanitizedSpotifyTrackId}?utm_source=generator&theme=0`}
          width="100%"
          height="152"
          loading="lazy"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        ></iframe>
      )}
    </div>
    <div class="about-wrapper">
      <h3>About</h3>
      <div>
        <p>{text}</p>
        {hasSocials && (
          <ul class="social-links">
            {githubUrl && (
              <li>
                <a href={githubUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub (Opens in new tab)">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
                  <span class="sr-only">GitHub</span>
                </a>
              </li>
            )}
            {linkedinUrl && (
              <li>
                <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (Opens in new tab)">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"></path></svg>
                  <span class="sr-only">LinkedIn</span>
                </a>
              </li>
            )}
            {instagramUrl && (
              <li>
                <a href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram (Opens in new tab)">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" fill="currentColor" aria-hidden="true"><path d="M295.42,6c-53.2,2.51-89.53,11-121.29,23.48-32.87,12.81-60.73,30-88.45,57.82S40.89,143,28.17,175.92c-12.31,31.83-20.65,68.19-23,121.42S2.3,367.68,2.56,503.46,3.42,656.26,6,709.6c2.54,53.19,11,89.51,23.48,121.28,12.83,32.87,30,60.72,57.83,88.45S143,964.09,176,976.83c31.8,12.29,68.17,20.67,121.39,23s70.35,2.87,206.09,2.61,152.83-.86,206.16-3.39S799.1,988,830.88,975.58c32.87-12.86,60.74-30,88.45-57.84S964.1,862,976.81,829.06c12.32-31.8,20.69-68.17,23-121.35,2.33-53.37,2.88-70.41,2.62-206.17s-.87-152.78-3.4-206.1-11-89.53-23.47-121.32c-12.85-32.87-30-60.7-57.82-88.45S862,40.87,829.07,28.19c-31.82-12.31-68.17-20.7-121.39-23S637.33,2.3,501.54,2.56,348.75,3.4,295.42,6m5.84,903.88c-48.75-2.12-75.22-10.22-92.86-17-23.36-9-40-19.88-57.58-37.29s-28.38-34.11-37.5-57.42c-6.85-17.64-15.1-44.08-17.38-92.83-2.48-52.69-3-68.51-3.29-202s.22-149.29,2.53-202c2.08-48.71,10.23-75.21,17-92.84,9-23.39,19.84-40,37.29-57.57s34.1-28.39,57.43-37.51c17.62-6.88,44.06-15.06,92.79-17.38,52.73-2.5,68.53-3,202-3.29s149.31.21,202.06,2.53c48.71,2.12,75.22,10.19,92.83,17,23.37,9,40,19.81,57.57,37.29s28.4,34.07,37.52,57.45c6.89,17.57,15.07,44,17.37,92.76,2.51,52.73,3.08,68.54,3.32,202s-.23,149.31-2.54,202c-2.13,48.75-10.21,75.23-17,92.89-9,23.35-19.85,40-37.31,57.56s-34.09,28.38-57.43,37.5c-17.6,6.87-44.07,15.07-92.76,17.39-52.73,2.48-68.53,3-202.05,3.29s-149.27-.25-202-2.53m407.6-674.61a60,60,0,1,0,59.88-60.1,60,60,0,0,0-59.88,60.1M245.77,503c.28,141.8,115.44,256.49,257.21,256.22S759.52,643.8,759.25,502,643.79,245.48,502,245.76,245.5,361.22,245.77,503m90.06-.18a166.67,166.67,0,1,1,167,166.34,166.65,166.65,0,0,1-167-166.34"></path></svg>
                  <span class="sr-only">Instagram</span>
                </a>
              </li>
            )}
            {stackoverflowUrl && (
              <li>
                <a href={stackoverflowUrl} target="_blank" rel="noopener noreferrer" aria-label="Stack Overflow (Opens in new tab)">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 169.61 200" fill="currentColor" aria-hidden="true"><path d="M140.44 178.38v-48.65h21.61V200H0v-70.27h21.61v48.65z"></path><path d="M124.24 140.54l4.32-16.22-86.97-17.83-3.78 17.83zM49.7 82.16L130.72 120l7.56-16.22-81.02-37.83zm22.68-40l68.06 57.3 11.35-13.51-68.6-57.3-11.35 13.51zM116.14 0l-14.59 10.81 53.48 71.89 14.58-10.81zM37.81 162.16h86.43v-16.21H37.81z"></path></svg>
                  <span class="sr-only">Stack Overflow</span>
                </a>
              </li>
            )}
          </ul>
        )}
      </div>
    </div>
  </article>
</section>

<style>
  .about-me article {
    display: flex;
  }

  .about-me article .introduction-wrapper {
    flex: 1;
  }
  
  .about-me article .about-wrapper {
    flex: 1;
  }

  .about-me article .introduction-wrapper h1 {
    color: var(--font-color-bold);
    margin: 0 0 1rem;
    letter-spacing: -.025em;
    font-weight: 700;
    font-size: 2.25rem;
    line-height: 2.5rem;
  }

  .about-me article .introduction-wrapper h2 {
    color: var(--font-color-bold);
    margin: 0 0 1rem;
    letter-spacing: -.025em;
    font-weight: 500;
    font-size: 1.125rem;
    line-height: 1.75rem;
  }

  .about-me article .about-wrapper h3 {
    color: var(--font-color-bold);
    letter-spacing: .1em;
    text-transform: uppercase;
    font-size: .875rem;
    line-height: 1.25rem;
    padding: 1.25rem 1.5rem;
    margin: 0 -1.5rem 1rem;
  }

  .about-me article .introduction-wrapper p,
  .about-me article .about-wrapper p {
    color: var(--font-color);
    margin: 0 0 1rem;
  }

  .about-me article .about-wrapper div .social-links {
    padding-left: 0;
    margin: 0;
  }

  .about-me article .about-wrapper div .social-links li {
    list-style: none;
    display: inline-block;
    transition: .3s;
    margin-right: 1rem;
  }

  .about-me article .about-wrapper div .social-links li:last-of-type {
    margin-right: 0;
  }

  .about-me article .about-wrapper div .social-links li a {
    display: flex;
    align-items: center;
    color: var(--font-color);
  }

  .about-me article .about-wrapper div .social-links li a:hover {
    color: var(--focus-color);
  }

  .about-me article .about-wrapper div .social-links li a svg {
    width: 25px;
    height: 25px;
    transition: .3s;
  }

  .spotify-iframe {
    border-radius: 15px;
    border: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  @media (max-width: 425px) {
    .about-me article {
      flex-direction: column;
      align-items: center;
    }
  }

  @media (min-width: 768px) {
    .about-me article .about-wrapper h3 {
      position: unset;
    }
  }
</style>
