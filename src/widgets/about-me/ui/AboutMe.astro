---
import GitHubIcon from "@/assets/github.svg";
import LinkedInIcon from "@/assets/linkedin.svg";
import InstagramIcon from "@/assets/instagram.svg";
import StackOverflowIcon from "@/assets/stackoverflow.svg";

interface Props {
  name?: string;
  profession?: string;
  text?: string;
  githubUrl?: string;
  linkedinUrl?: string;
  instagramUrl?: string;
  stackoverflowUrl?: string;
}

const {
  name = "John Doe",
  profession = "Jedi Council Member (Not Master though)",
  text = "I don't like sand. It's coarse and rough and irritating, and it gets everywhere.",
  githubUrl = "",
  linkedinUrl = "",
  instagramUrl = "",
  stackoverflowUrl = ""
} = Astro.props;

const hasSocials = Boolean(githubUrl || linkedinUrl || instagramUrl || stackoverflowUrl);
---

<section id="about-me" class="about-me">
  <article>
    <div class="introduction-wrapper">
      <h1>{name}</h1>
      <h2>{profession}</h2>
    </div>
    <div class="about-wrapper">
      <h3>About</h3>
      <div>
        <p>{text}</p>
        {hasSocials && (
          <ul class="social-links">
            {githubUrl && (
              <li>
                <a href={githubUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub (Opens in new tab)">
                  <GitHubIcon width="25" height="25" aria-hidden="true" />
                  <span class="sr-only">GitHub</span>
                </a>
              </li>
            )}
            {linkedinUrl && (
              <li>
                <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (Opens in new tab)">
                  <LinkedInIcon width="25" height="25" aria-hidden="true" />
                  <span class="sr-only">LinkedIn</span>
                </a>
              </li>
            )}
            {instagramUrl && (
              <li>
                <a href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram (Opens in new tab)">
                  <InstagramIcon width="25" height="25" aria-hidden="true" />
                  <span class="sr-only">Instagram</span>
                </a>
              </li>
            )}
            {stackoverflowUrl && (
              <li>
                <a href={stackoverflowUrl} target="_blank" rel="noopener noreferrer" aria-label="Stack Overflow (Opens in new tab)">
                  <StackOverflowIcon width="25" height="25" aria-hidden="true" />
                  <span class="sr-only">Stack Overflow</span>
                </a>
              </li>
            )}
          </ul>
        )}
      </div>
    </div>
  </article>
</section>

<style>
  .about-me article .introduction-wrapper h1 {
    color: var(--font-color-bold);
    margin: 0 0 var(--space-4);
    letter-spacing: var(--letter-spacing-tight);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-2xl);
    line-height: var(--line-height-xl);
  }

  .about-me article .introduction-wrapper h2 {
    color: var(--font-color-bold);
    margin: 0 0 var(--space-4);
    letter-spacing: var(--letter-spacing-tight);
    font-weight: var(--font-weight-medium);
    font-size: var(--font-size-md);
    line-height: var(--line-height-md);
  }

  .about-me article .about-wrapper h3 {
    color: var(--font-color-bold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-sm);
    padding: var(--space-5) var(--space-6);
    margin: 0 calc(-1 * var(--space-6)) var(--space-4);
  }

  .about-me article .about-wrapper p {
    color: var(--font-color);
    margin: 0 0 var(--space-4);
  }

  .about-me article .about-wrapper div .social-links {
    padding-left: 0;
    margin: 0;
  }

  .about-me article .about-wrapper div .social-links li {
    list-style: none;
    display: inline-block;
    transition: .3s;
    margin-right: var(--space-4);
  }

  .about-me article .about-wrapper div .social-links li:last-of-type {
    margin-right: 0;
  }

  .about-me article .about-wrapper div .social-links li a {
    display: flex;
    align-items: center;
    color: var(--font-color);
  }

  .about-me article .about-wrapper div .social-links li a:hover {
    color: var(--focus-color);
  }

  .about-me article .about-wrapper div .social-links li a svg {
    width: var(--size-icon-sm);
    height: var(--size-icon-sm);
    transition: .3s;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
