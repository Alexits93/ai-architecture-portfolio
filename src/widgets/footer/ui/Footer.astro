---
const currentYear = new Date().getFullYear();
---

<footer class="app-footer" data-testid="app-footer">
  <p>&copy;{currentYear} Patrik Alexits - Made with <a href="https://astro.build/" data-testid="framework-link">Astro</a> - Web Components are fun!</p>
  <div>
    <p><a href="/cookie-disclaimer/" data-testid="cookie-link">Cookie disclaimer</a></p>
    <p><a href="/privacy-policy/" data-testid="privacy-link">Privacy policy</a></p>
  </div>
</footer>

<style>
  .app-footer {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .app-footer p {
    display: inline-block;
    margin: 0;
  }

  .app-footer a {
    color: var(--font-color);
  }
</style>
