---
import Logo from '@/assets/logo.svg';
---

<div class="header-wrapper">
  <header>
    <button id="site-menu-open-btn" class="navigator-menu-opener" aria-label="Open menu">
      <span></span>
      <span></span>
    </button>

    <a href="/">
      <span class="sr-only">Back to Home page</span>
      <Logo width="79.42" height="50" aria-hidden="true" />
    </a>

    <button class="theme-toggle" aria-label="Dark theme" aria-pressed="false">
      <svg class="icon moon" aria-hidden="true" fill="currentColor" width="50" height="50" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"><path d="M480-120q-150 0-255-105T120-480q0-150 105-255t255-105q14 0 27.5 1t26.5 3q-41 29-65.5 75.5T444-660q0 90 63 153t153 63q55 0 101-24.5t75-65.5q2 13 3 26.5t1 27.5q0 150-105 255T480-120Zm0-80q88 0 158-48.5T740-375q-20 5-40 8t-40 3q-123 0-209.5-86.5T364-660q0-20 3-40t8-40q-78 32-126.5 102T200-480q0 116 82 198t198 82Zm-10-270Z"/></svg>
      <svg class="icon sun" aria-hidden="true" fill="currentColor" width="50" height="50" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"><path d="M480-360q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35Zm0 80q-83 0-141.5-58.5T280-480q0-83 58.5-141.5T480-680q83 0 141.5 58.5T680-480q0 83-58.5 141.5T480-280ZM200-440H40v-80h160v80Zm720 0H760v-80h160v80ZM440-760v-160h80v160h-80Zm0 720v-160h80v160h-80ZM256-650l-101-97 57-59 96 100-52 56Zm492 496-97-101 53-55 101 97-57 59Zm-98-550 97-101 59 57-100 96-56-52ZM154-212l101-97 55 53-97 101-59-57Zm326-268Z"/></svg>
    </button>
  </header>
</div>

<script>
  import { getStoredTheme, onThemeChange, toggleTheme, type Theme } from '@/shared/stores/ui';

  const themeBtn = document.querySelector('.theme-toggle');
  const darkScheme = matchMedia('(prefers-color-scheme: dark)');
  const systemTheme = (): Theme => (darkScheme.matches ? 'dark' : 'light');

  if (themeBtn) {
    // Without a stored choice the page keeps no data-theme and shows the OS theme.
    const render = () => {
      const stored = getStoredTheme();
      const theme = stored ?? systemTheme();
      themeBtn.setAttribute('aria-pressed', String(theme === 'dark'));
      if (stored) {
        document.documentElement.setAttribute('data-theme', stored);
      } else {
        document.documentElement.removeAttribute('data-theme');
      }
    };

    themeBtn.addEventListener('click', () => toggleTheme(systemTheme()));
    onThemeChange(render);
    render();
    darkScheme.addEventListener('change', render);
  }
</script>

<style>
  .header-wrapper {
      position: sticky;
      top: 0;
      z-index: 10000;
  }
  .header-wrapper header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem;
      background-color: var(--body-background);
      color: var(--font-color);
  }
  .header-wrapper header a:active,
  .header-wrapper header a:focus,
  .header-wrapper header a:focus-visible {
      outline: 2px solid var(--focus-color);
  }
  .header-wrapper header a {
      text-decoration: none;
      color: var(--font-color);
  }
  .header-wrapper header a svg {
      height: 50px;
  }
  .header-wrapper header button {
      background: none;
      border: none;
      cursor: pointer;
  }
  /* The icon takes the theme colour; aria-pressed picks the icon for the other theme. */
  .theme-toggle {
      color: var(--font-color-bold);
  }
  .theme-toggle[aria-pressed="false"] .sun,
  .theme-toggle[aria-pressed="true"] .moon {
      display: none;
  }
  .navigator-menu-opener {
      display: flex;
      flex-direction: column;
      justify-content: center;
      cursor: pointer;
      padding: 0 .5rem;
      width: 3rem;
      height: 3rem;
      gap: .5rem;
      background: none;
      border: none;
      position: relative;
      z-index: 9999;
  }
  .navigator-menu-opener span {
      display: block;
      transition: all .3s ease-in-out;
      height: .2rem;
      width: 2rem;
      background-color: var(--font-color-bold);
      border-radius: 2px;
  }
  .navigator-menu-opener:focus-visible {
      outline: 2px solid var(--focus-color);
  }
  .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
  }
</style>
