---
import Logo from '@/assets/logo.svg';
import MoonIcon from '@/assets/moon.svg';
import SunIcon from '@/assets/sun.svg';
---

<div class="header-wrapper">
  <header>
    <button class="navigator-menu-opener" commandfor="site-menu" command="show-modal" aria-label="Open menu">
      <span></span>
      <span></span>
    </button>

    <a href="/">
      <span class="sr-only">Back to Home page</span>
      <Logo width="79.42" height="50" aria-hidden="true" />
    </a>

    <button class="theme-toggle" aria-label="Dark theme" aria-pressed="false">
      <MoonIcon class="icon moon" width="50" height="50" aria-hidden="true" />
      <SunIcon class="icon sun" width="50" height="50" aria-hidden="true" />
    </button>
  </header>
</div>

<script>
  import { getStoredTheme, onThemeChange, toggleTheme, type Theme } from '@/shared/stores/ui';

  const themeBtn = document.querySelector('.theme-toggle');
  const darkScheme = matchMedia('(prefers-color-scheme: dark)');
  const systemTheme = (): Theme => (darkScheme.matches ? 'dark' : 'light');

  if (themeBtn) {
    // Without a stored choice the page keeps no data-theme and shows the OS theme.
    const render = () => {
      const stored = getStoredTheme();
      const theme = stored ?? systemTheme();
      themeBtn.setAttribute('aria-pressed', String(theme === 'dark'));
      if (stored) {
        document.documentElement.setAttribute('data-theme', stored);
      } else {
        document.documentElement.removeAttribute('data-theme');
      }
    };

    themeBtn.addEventListener('click', () => toggleTheme(systemTheme()));
    onThemeChange(render);
    render();
    darkScheme.addEventListener('change', render);
  }
</script>

<style>
  .header-wrapper {
      position: sticky;
      top: 0;
      /* Above positioned page content while sticky; the open menu sits in the top layer. */
      z-index: 1;
  }
  .header-wrapper header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: var(--space-4);
      background-color: var(--body-background);
      color: var(--font-color);
  }
  .header-wrapper header a:active,
  .header-wrapper header a:focus,
  .header-wrapper header a:focus-visible {
      outline: var(--outline-width-focus) solid var(--focus-color);
  }
  .header-wrapper header a {
      text-decoration: none;
      color: var(--font-color);
  }
  /* Block icons keep the header --space-4 + --size-icon-lg + --space-4 tall in every engine; the menu close button relies on it. */
  .header-wrapper header svg {
      display: block;
  }
  .header-wrapper header a svg {
      height: var(--size-icon-lg);
  }
  .header-wrapper header button {
      background: none;
      border: none;
      cursor: pointer;
  }
  /* The icon takes the theme colour; aria-pressed picks the icon for the other theme. */
  .theme-toggle {
      padding: 0;
      color: var(--font-color-bold);
  }
  .theme-toggle:focus-visible {
      outline: var(--outline-width-focus) solid var(--focus-color);
  }
  .theme-toggle[aria-pressed="false"] .sun,
  .theme-toggle[aria-pressed="true"] .moon {
      display: none;
  }
  .navigator-menu-opener {
      display: flex;
      flex-direction: column;
      justify-content: center;
      cursor: pointer;
      padding: 0 var(--space-2);
      width: var(--space-12);
      height: var(--space-12);
      gap: var(--space-2);
      background: none;
      border: none;
  }
  .navigator-menu-opener span {
      display: block;
      transition: all .3s ease-in-out;
      height: .2rem;
      width: var(--space-8);
      background-color: var(--font-color-bold);
      border-radius: var(--radius-xs);
  }
  .navigator-menu-opener:focus-visible {
      outline: var(--outline-width-focus) solid var(--focus-color);
  }
  .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
  }
</style>
