---
import { getCollection } from 'astro:content';
import { BlogPostThumbnail } from '@/entities/blog-post';

interface Props {
  blogPostClass?: string;
}

const { blogPostClass = "" } = Astro.props;
const allPosts = await getCollection('blog');
const recommendedPosts = allPosts.filter((p) => p.data.isRecommended).slice(0, 3);
---
<section id="blog-section" class:list={[blogPostClass]}>
  <div class="wrapper-top">
    <h1>Recommended Articles</h1>
  </div>
  <div class="wrapper">
    {recommendedPosts.map(post => (
      <BlogPostThumbnail post={post} />
    ))}
  </div>
  <div class="wrapper-bottom">
    <a href="/blog">See more</a>
  </div>
</section>

<style>
  #blog-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  #blog-section .wrapper-top {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  #blog-section .wrapper-top h1 {
    color: var(--font-color-bold);
    margin: 0;
    letter-spacing: -.025em;
    font-weight: 700;
    font-size: 2.25rem;
    line-height: 2.5rem;
  }

  #blog-section .wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 400px));
    gap: 1rem;
    margin-bottom: 1rem;
    justify-content: center;
  }

  #blog-section .wrapper-bottom {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #blog-section .wrapper-bottom a {
    padding: .5rem;
    background-color: var(--theme-secondary);
    border-radius: 10px;
    color: var(--font-color);
    text-decoration: none;
    transition: background-color .3s ease-in-out;
  }

  #blog-section .wrapper-bottom a:hover {
    background-color: var(--thumbnail-bg-color);
  }


  @media (min-width: 768px) {
    #blog-section .wrapper {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #blog-section .wrapper-top h1 {
      text-align: left;
    }
  }

  @media (min-width: 1024px) {
    #blog-section.blog-post-page .wrapper {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    #blog-section .wrapper {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
