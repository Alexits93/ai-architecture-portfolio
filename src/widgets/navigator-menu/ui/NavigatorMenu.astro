---
export interface Props {
    menuItems?: { name: string; path: string }[];
}
const defaultMenuItems = [
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog/' },
    { name: 'CV', path: '/cv/' }
];
const { menuItems = defaultMenuItems } = Astro.props;
---
<dialog id="site-menu" aria-label="Site navigation">
    <div class="navigator-menu-overlay" aria-hidden="true"></div>
    <button class="navigator-menu-opener" commandfor="site-menu" command="close" aria-label="Close menu">
        <span></span>
        <span></span>
    </button>
    <div class="navigator-menu-body">
        <ul>
            {menuItems.map(item => (
                <li><a href={item.path}><h2>{item.name}</h2></a></li>
            ))}
        </ul>
    </div>
</dialog>

<script>
    // No HTML or CSS closes a dialog when a link navigates. Close it before the page enters the back/forward
    // cache, so Back restores it closed (https://developer.mozilla.org/en-US/docs/Web/API/Window/pagehide_event).
    const menu = document.getElementById('site-menu');
    if (menu instanceof HTMLDialogElement) addEventListener('pagehide', () => menu.close());
</script>

<style>
    dialog#site-menu {
        --menu-origin: 2.5rem 2.6rem;
        --menu-ease: cubic-bezier(0.76, 0, 0.24, 1);
        --menu-duration: 0.6s;
        margin: 0; padding: 0;
        width: 100vw; height: 100vh;
        max-width: 100vw; max-height: 100vh;
        border: none; background: transparent;
        color: var(--font-color);
        display: none;
        transition: display var(--menu-duration) allow-discrete, overlay var(--menu-duration) allow-discrete;
    }
    
    dialog#site-menu::backdrop { background: transparent; }
    dialog#site-menu[open] { display: block; }

    .navigator-menu-overlay {
        position: absolute; inset: 0; z-index: 1;
        background-color: var(--body-background);
        clip-path: circle(0 at var(--menu-origin));
        transition: clip-path var(--menu-duration) var(--menu-ease);
    }
    dialog#site-menu[open] .navigator-menu-overlay { clip-path: circle(150vmax at var(--menu-origin)); }
    
    @starting-style {
        dialog#site-menu[open] .navigator-menu-overlay { clip-path: circle(0 at var(--menu-origin)); }
    }

    /* Over the header hamburger: header padding 1rem, 3rem button centred in the 50px header row. */
    .navigator-menu-opener {
        position: absolute; z-index: 3;
        top: calc(1rem + (50px - 3rem) / 2); left: 1rem;
        display: flex; flex-direction: column; justify-content: center; cursor: pointer;
        padding: 0 .5rem; width: 3rem; height: 3rem; gap: .5rem; background: none; border: none;
        transition: gap 0.3s ease-in-out;
    }
    .navigator-menu-opener span {
        display: block; transition: all 0.3s ease-in-out;
        height: .2rem; width: 2rem; background-color: var(--font-color-bold);
        border-radius: 2px; transform: translateY(0) rotate(0deg);
    }
    .navigator-menu-opener:focus-visible { outline: 2px solid var(--focus-color); }

    dialog#site-menu[open] .navigator-menu-opener { gap: 0; }
    dialog#site-menu[open] .navigator-menu-opener span:first-of-type { transform: translateY(0.1rem) rotate(45deg); }
    dialog#site-menu[open] .navigator-menu-opener span:last-of-type { transform: translateY(-0.1rem) rotate(-45deg); }

    @starting-style {
        dialog#site-menu[open] .navigator-menu-opener { gap: .5rem; }
        dialog#site-menu[open] .navigator-menu-opener span:first-of-type { transform: translateY(0) rotate(0deg); }
        dialog#site-menu[open] .navigator-menu-opener span:last-of-type { transform: translateY(0) rotate(0deg); }
    }

    .navigator-menu-body {
        position: relative; z-index: 2; width: 100%; height: 100%;
        display: flex; justify-content: center; align-items: center;
    }
    .navigator-menu-body ul {
        display: flex; flex-direction: column; align-items: center;
        gap: 3rem; list-style: none; padding: 0; margin: 0;
    }
    .navigator-menu-body li {
        opacity: 0; translate: 0 1.5rem;
        transition: opacity 0.25s ease, translate 0.25s ease;
    }

    dialog#site-menu[open] .navigator-menu-body li {
        opacity: 1; translate: 0 0;
        transition: opacity 0.4s ease, translate 0.4s var(--menu-ease);
        transition-delay: 0.25s;
    }
    
    @starting-style {
        dialog#site-menu[open] .navigator-menu-body li { opacity: 0; translate: 0 1.5rem; }
    }
    dialog#site-menu[open] .navigator-menu-body li:nth-child(2) { transition-delay: 0.33s; }
    dialog#site-menu[open] .navigator-menu-body li:nth-child(3) { transition-delay: 0.41s; }

    .navigator-menu-body ul li a { display: flex; color: var(--font-color); text-decoration: none; }
    .navigator-menu-body ul li a:focus-visible { outline: 2px solid var(--focus-color); }
    .navigator-menu-body ul li a h2 {
        display: inline-block; margin: 0; font-size: 48px;
        line-height: 1.2; color: var(--font-color-bold);
    }
</style>
