---
export interface Props {
    menuItems?: { name: string; path: string }[];
}

const defaultMenuItems = [
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog/' },
    { name: 'CV', path: '/cv/' }
];

const { menuItems = defaultMenuItems } = Astro.props;
---

<dialog id="site-menu" aria-label="Site navigation">
    <div class="dialog-header">
        <button id="site-menu-close-btn" class="navigator-menu-opener is-open" aria-label="Close menu">
            <span></span>
            <span></span>
        </button>
    </div>
    <div class="navigator-menu-body">
        <ul>
            {menuItems.map(item => (
                <li>
                    <a href={item.path}>
                        <h2>{item.name}</h2>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</dialog>

<script>
    const setupMenu = () => {
        const openBtn = document.getElementById('site-menu-open-btn');
        const closeBtn = document.getElementById('site-menu-close-btn');
        const dialog = document.getElementById('site-menu') as HTMLDialogElement;
        
        if (!openBtn || !closeBtn || !dialog) return;

        openBtn.addEventListener('click', () => {
            dialog.showModal();
        });

        closeBtn.addEventListener('click', () => {
            dialog.close();
        });

        const links = dialog.querySelectorAll('a');
        links.forEach(link => {
            link.addEventListener('click', () => {
                dialog.close();
            });
        });

        // Dialog close native event binds Esc key.
        // Prevent backdrop click from closing if desired, but native behavior already does not close on backdrop.
    };
    
    document.addEventListener('astro:page-load', setupMenu);
    setupMenu();
</script>

<style>
    dialog#site-menu {
        --menu-origin: 2.5rem 2.6rem;
        --menu-ease: cubic-bezier(0.76, 0, 0.24, 1);
        --menu-duration: 0.6s;
        
        margin: 0;
        padding: 0;
        width: 100vw;
        height: 100vh;
        max-width: 100vw;
        max-height: 100vh;
        border: none;
        background-color: var(--body-background);
        color: var(--font-color);
        
        display: none;
        opacity: 0;
        clip-path: circle(0 at var(--menu-origin));
        transition:
            opacity var(--menu-duration) var(--menu-ease),
            clip-path var(--menu-duration) var(--menu-ease),
            display var(--menu-duration) allow-discrete,
            overlay var(--menu-duration) allow-discrete;
    }
    
    dialog#site-menu::backdrop {
        background: transparent;
    }

    dialog#site-menu[open] {
        display: flex;
        flex-direction: column;
        opacity: 1;
        clip-path: circle(150vmax at var(--menu-origin));
    }
    
    @starting-style {
        dialog#site-menu[open] {
            opacity: 0;
            clip-path: circle(0 at var(--menu-origin));
        }
    }

    .dialog-header {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        display: flex;
        justify-content: flex-start;
        padding: 1rem;
        box-sizing: border-box;
    }

    .navigator-menu-opener {
        display: flex;
        flex-direction: column;
        cursor: pointer;
        padding: .5rem;
        gap: .5rem;
        background: none;
        border: none;
        position: relative;
        z-index: 9999;
    }
    .navigator-menu-opener.is-open {
        padding: 1rem .5rem;
        gap: 0;
    }
    .navigator-menu-opener span {
        display: block;
        transition: all .3s ease-in-out;
        height: .2rem;
        width: 2rem;
        background-color: var(--font-color-bold);
        border-radius: 2px;
    }
    .navigator-menu-opener.is-open span {
        background-color: #ffffff;
    }
    .navigator-menu-opener.is-open span:first-of-type {
        transform: translateY(0.1rem) rotate(45deg);
    }
    .navigator-menu-opener.is-open span:last-of-type {
        transform: translateY(-0.1rem) rotate(-45deg);
    }
    .navigator-menu-opener:focus-visible {
        outline: 2px solid var(--focus-color);
    }

    .navigator-menu-body {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .navigator-menu-body ul {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .navigator-menu-body li {
        opacity: 0;
        translate: 0 1.5rem;
        transition:
            opacity 0.25s ease,
            translate 0.25s ease;
    }

    dialog#site-menu[open] .navigator-menu-body li {
        opacity: 1;
        translate: 0 0;
        transition:
            opacity 0.4s ease,
            translate 0.4s var(--menu-ease);
        transition-delay: 0.25s;
    }
    
    @starting-style {
        dialog#site-menu[open] .navigator-menu-body li {
            opacity: 0;
            translate: 0 1.5rem;
        }
    }

    dialog#site-menu[open] .navigator-menu-body li:nth-child(2) {
        transition-delay: 0.33s;
    }

    dialog#site-menu[open] .navigator-menu-body li:nth-child(3) {
        transition-delay: 0.41s;
    }

    .navigator-menu-body ul li a {
        display: flex;
        color: var(--font-color);
        text-decoration: none;
    }

    .navigator-menu-body ul li a:focus-visible {
        outline: 2px solid var(--focus-color);
        outline-offset: 4px;
    }

    .navigator-menu-body ul li a h2 {
        display: inline-block;
        margin: 0;
        font-size: 48px;
        line-height: 1.2;
        color: var(--font-color-bold);
    }
</style>
