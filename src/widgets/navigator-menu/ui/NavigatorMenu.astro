---
export interface Props {
    menuItems?: { name: string; path: string }[];
}

const defaultMenuItems = [
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog/' },
    { name: 'CV', path: '/cv/' }
];

const { menuItems = defaultMenuItems } = Astro.props;
---

<section id="navigator-menu">
    <div class="navigator-menu-overlay" aria-hidden="true"></div>
    <div class="navigator-menu-body">
        <ul>
            {menuItems.map(item => (
                <li>
                    <a href={item.path}>
                        <h2>{item.name}</h2>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    section#navigator-menu {
        display: block;
        pointer-events: none; /* Let clicks pass through when closed */
        position: fixed;
        z-index: 9999;
    }

    body:has(#mobile-menu-toggle:checked) section#navigator-menu, body.is-menu-open section#navigator-menu {
        pointer-events: auto; /* Enable clicks when open */
    }

    section#navigator-menu .navigator-menu-body {
        display: none;
    }

    body:has(#mobile-menu-toggle:checked) section#navigator-menu .navigator-menu-overlay, body.is-menu-open section#navigator-menu .navigator-menu-overlay {
        display: flex;
        position: fixed;
        flex-direction: column;
        width: 100vw;
        height: 100vh;
        top: 0;
        left: 0;
        backdrop-filter: blur(35px);
        -webkit-backdrop-filter: blur(35px);
        background: rgba(0, 0, 0, 0.4);
        justify-content: center;
        align-items: center;
        z-index: 9998;
    }

    body:has(#mobile-menu-toggle:checked) section#navigator-menu .navigator-menu-body, body.is-menu-open section#navigator-menu .navigator-menu-body {
        display: flex;
        position: fixed;
        flex-direction: column;
        width: 100vw;
        height: 100vh;
        top: 0;
        left: 0;
        justify-content: center;
        align-items: center;
        z-index: 9999;
        pointer-events: none;
    }

    body:has(#mobile-menu-toggle:checked) section#navigator-menu .navigator-menu-body ul, body.is-menu-open section#navigator-menu .navigator-menu-body ul {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3rem;
        list-style: none;
        padding: 0;
        margin: 0;
        pointer-events: auto;
    }

    body:has(#mobile-menu-toggle:checked) section#navigator-menu .navigator-menu-body ul li a, body.is-menu-open section#navigator-menu .navigator-menu-body ul li a {
        display: flex;
        color: var(--font-color);
        text-decoration: none;
    }

    body:has(#mobile-menu-toggle:checked) section#navigator-menu .navigator-menu-body ul li a:active, body.is-menu-open section#navigator-menu .navigator-menu-body ul li a:active,
    body:has(#mobile-menu-toggle:checked) section#navigator-menu .navigator-menu-body ul li a:focus, body.is-menu-open section#navigator-menu .navigator-menu-body ul li a:focus,
    body:has(#mobile-menu-toggle:checked) section#navigator-menu .navigator-menu-body ul li a:focus-visible, body.is-menu-open section#navigator-menu .navigator-menu-body ul li a:focus-visible {
        outline: 2px solid var(--focus-color);
        outline-offset: 4px;
    }

    body:has(#mobile-menu-toggle:checked) section#navigator-menu .navigator-menu-body ul li a h2, body.is-menu-open section#navigator-menu .navigator-menu-body ul li a h2 {
        display: inline-block;
        margin: 0;
        font-size: 48px;
        line-height: 1.2;
        color: var(--font-color-bold);
    }
</style>
