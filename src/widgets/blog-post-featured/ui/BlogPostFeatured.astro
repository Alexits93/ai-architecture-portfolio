    color: var(--font-color);
  }
  
  @media (min-width: 768px) {
    #blog-featured .wrapper {
      justify-content: flex-start;
    }
  
    #blog-featured .wrapper h1 {
      text-align: left;
    }
  }
  
  @media (min-width: 1024px) {
    #blog-featured .wrapper {
      justify-content: flex-end;
