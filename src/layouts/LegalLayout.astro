---
// The legal pages: a Legal eyebrow, a display title, and text at a readable line length.
import DisplayHeading from "@/components/DisplayHeading.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import { SITE } from "@/consts";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  /** The title's plain words, then its accent words. */
  text: string;
  accent: string;
  description: string;
}

const { text, accent, description } = Astro.props;
---

<BaseLayout
  title={`${text} ${accent} | ${SITE.name}`}
  description={description}
>
  <main>
    <section class="legal">
      <Eyebrow>Legal</Eyebrow>
      <DisplayHeading
        as="h1"
        size="section"
        class="title"
        text={text}
        accent={accent}
      />
      <slot />
    </section>
  </main>
</BaseLayout>

<style>
  /* main pads the page; the text keeps a readable line length inside the page width, as the blog head does. */
  .legal {
    width: 100%;
    max-width: var(--page-max-width);
    margin: 0 auto;
  }
  .legal > :global(:not(.title)) {
    max-width: var(--size-prose);
  }
  .title {
    margin: 0 0 var(--space-6);
  }
  .legal :global(h2) {
    color: var(--font-color-bold);
    margin: var(--space-10) 0 var(--space-2);
    letter-spacing: var(--letter-spacing-tight);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-xl);
    line-height: var(--line-height-lg);
  }
  .legal :global(p + p) {
    margin-block-start: var(--space-4);
  }
  .legal :global(ul) {
    margin-block: 0 var(--space-4);
    padding-inline-start: var(--space-6);
  }
</style>
