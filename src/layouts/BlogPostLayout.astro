---
import type { CollectionEntry } from 'astro:content';
import { ROUTES, SITE } from '@/consts';
import type { JsonLdObject } from '@/lib/json-ld';
import { getPostPath } from '@/lib/permalink';
import { modifiedDate } from '@/lib/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, subtitle, description, publishDate } = post.data;
const pageUrl = new URL(getPostPath(post), Astro.site).href;
// Each post shares its own image, drawn by src/pages/blog/[slug]/og.png.ts from the title and subtitle.
const ogImage = { path: `${getPostPath(post)}og.png`, alt: `${title}. ${subtitle}` };

// https://developers.google.com/search/docs/appearance/structured-data/article. Google does not read mainEntityOfPage;
// Schema.org does, and it ties the post to its canonical URL.
const jsonLd: JsonLdObject = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: new URL(ogImage.path, Astro.site).href,
  datePublished: publishDate.toISOString(),
  dateModified: modifiedDate(post.data).toISOString(),
  mainEntityOfPage: pageUrl,
  author: { '@type': 'Person', name: SITE.author, url: new URL(ROUTES.cv, Astro.site).href },
};

// The card-to-post morph names #post-hero on pagereveal, so the head asks the first render to wait until it is
// parsed (rel="expect", https://developer.chrome.com/docs/web-platform/view-transitions/cross-document).
---

{/* A draft is a test article: noindex keeps it out of search results. */}
<BaseLayout title={`${title} | ${SITE.name}`} description={description} type="article" ogImage={ogImage} publishedTime={publishDate} jsonLd={jsonLd} noindex={post.data.draft}>
	<link slot="head" rel="expect" href="#post-hero" blocking="render" />
	<slot />
</BaseLayout>
