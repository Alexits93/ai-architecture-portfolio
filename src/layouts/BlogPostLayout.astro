---
import type { CollectionEntry } from 'astro:content';
import { ROUTES, SITE } from '@/consts';
import type { JsonLdObject } from '@/lib/json-ld';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, publishDate } = post.data;

// https://developers.google.com/search/docs/appearance/structured-data/article
const jsonLd: JsonLdObject = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: publishDate.toISOString(),
  author: { '@type': 'Person', name: SITE.author, url: new URL(ROUTES.cv, Astro.site).href },
};

// The card-to-post morph names #post-hero on pagereveal, so the head asks the first render to wait until it is
// parsed (rel="expect", #210, https://developer.chrome.com/docs/web-platform/view-transitions/cross-document).
---

<BaseLayout title={`${title} | ${SITE.name}`} description={description} type="article" publishedTime={publishDate} jsonLd={jsonLd}>
	<link slot="head" rel="expect" href="#post-hero" blocking="render" />
	<slot />
</BaseLayout>
