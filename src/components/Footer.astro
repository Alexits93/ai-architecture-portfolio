---
import { ROUTES, SITE } from "@/consts";

const currentYear = new Date().getFullYear();
---

<footer class="app-footer">
  <p>&copy;{currentYear} Patrik Alexits - Made with <a href="https://astro.build/">Astro</a></p>
  <div>
    <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    <p><a href={ROUTES.cookieDisclaimer}>Cookie disclaimer</a></p>
    <p><a href={ROUTES.privacyPolicy}>Privacy policy</a></p>
  </div>
</footer>

<style>
  .app-footer {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  /* compressHTML removes the whitespace between the links, so the gap comes from flex. */
  .app-footer div {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
  }

  .app-footer p {
    display: inline-block;
    margin: 0;
  }

  .app-footer a {
    color: var(--font-color);
  }
</style>
