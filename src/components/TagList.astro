---
// A row of tags: the tools of a home service card, the skills of a CV position.
interface Props {
  items: readonly string[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ul class:list={['tag-list', className]}>{items.map((item) => <li>{item}</li>)}</ul>

<style>
  .tag-list { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .tag-list li {
    padding: var(--space-1) var(--space-4); border-radius: var(--radius-pill); font-size: var(--font-size-sm);
    border: var(--border-width-hairline) solid var(--hairline-color);
  }
</style>
