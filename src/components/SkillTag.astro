---
interface Props {
  skill: string;
}

const { skill } = Astro.props;
---

<span class="skill-tag">
  {`#${skill.toLocaleLowerCase()}`}
</span>

<style>
  .skill-tag {
    display: inline-block;
    font-size: var(--font-size-base);
    padding: var(--space-1);
    font-style: italic;
    color: var(--font-color);
  }
</style>
