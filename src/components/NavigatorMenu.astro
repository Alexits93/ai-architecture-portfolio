---
import { ROUTES } from '@/consts';

const menuItems = [
    { name: 'Home', path: ROUTES.home },
    { name: 'About', path: ROUTES.about },
    { name: 'Blog', path: ROUTES.blog },
    { name: 'CV', path: ROUTES.cv }
];
---
<dialog id="site-menu" aria-label="Site navigation">
    <div class="navigator-menu-overlay" aria-hidden="true"></div>
    <button class="navigator-menu-opener" commandfor="site-menu" command="close" aria-label="Close menu">
        <span></span>
        <span></span>
    </button>
    <div class="navigator-menu-body">
        <ul>
            {menuItems.map(item => (
                <li><a href={item.path}><span>{item.name}</span></a></li>
            ))}
        </ul>
    </div>
</dialog>

<script>
    // No HTML or CSS closes a dialog when a link navigates. Close it before the page enters the back/forward
    // cache, so Back restores it closed (https://developer.mozilla.org/en-US/docs/Web/API/Window/pagehide_event).
    const menu = document.getElementById('site-menu');
    if (menu instanceof HTMLDialogElement) {
        addEventListener('pagehide', () => menu.close());

        // CSS alone cannot animate the close in every engine: Firefox transitions neither display nor overlay, and
        // keeping the closed dialog rendered breaks WebKit's initial focus (#206). So the close button's command and
        // Esc's cancel are held while data-closing plays the closing transitions, then the dialog closes.
        // getAnimations() applies pending style changes first, so it returns the transitions just started
        // (https://drafts.csswg.org/web-animations-1/#dom-animatable-getanimations).
        const closeAnimated = () => {
            if (menu.dataset.closing !== undefined) return;
            menu.dataset.closing = '';
            const running = menu.getAnimations({ subtree: true }).map((animation) => animation.finished);
            void Promise.allSettled(running).then(() => {
                menu.close();
                delete menu.dataset.closing;
            });
        };
        menu.addEventListener('command', (event) => {
            if (!(event instanceof CommandEvent) || event.command !== 'close') return;
            event.preventDefault();
            closeAnimated();
        });
        menu.addEventListener('cancel', (event) => {
            event.preventDefault();
            closeAnimated();
        });
    }
</script>

<style>
    dialog#site-menu {
        --menu-origin: var(--space-10) 2.6rem;
        /* The links fade out in --menu-item-exit; on open they wait that long, then enter one step apart. */
        --menu-item-exit: .25s;
        --menu-item-step: 80ms;
        margin: 0; padding: 0;
        width: 100vw; height: 100vh;
        max-width: 100vw; max-height: 100vh;
        border: none; background: transparent;
        color: var(--font-color);
        display: none;
    }

    dialog#site-menu::backdrop { background: transparent; }
    /* While data-closing is set the dialog stays open and the parts transition back to their closed values. */
    dialog#site-menu[open] { display: block; }

    .navigator-menu-overlay {
        position: absolute; inset: 0; z-index: 1;
        background-color: var(--body-background);
        clip-path: circle(0 at var(--menu-origin));
        transition: clip-path var(--duration-6) var(--ease-in-out-strong);
    }
    dialog#site-menu[open]:not([data-closing]) .navigator-menu-overlay { clip-path: circle(150vmax at var(--menu-origin)); }
    
    @starting-style {
        dialog#site-menu[open]:not([data-closing]) .navigator-menu-overlay { clip-path: circle(0 at var(--menu-origin)); }
    }

    /* Over the header hamburger: header padding, then the button centred in the header icon row. */
    .navigator-menu-opener {
        position: absolute; z-index: 3;
        top: calc(var(--space-4) + (var(--size-icon-lg) - var(--space-12)) / 2); left: var(--space-4);
        display: flex; flex-direction: column; justify-content: center; cursor: pointer;
        padding: 0 var(--space-2); width: var(--space-12); height: var(--space-12); gap: var(--space-2); background: none; border: none;
        transition: gap var(--duration-3) ease-in-out;
    }
    .navigator-menu-opener span {
        display: block; transition: transform var(--duration-3) ease-in-out;
        height: .2rem; width: var(--space-8); background-color: var(--font-color-bold);
        border-radius: var(--radius-xs); transform: translateY(0) rotate(0deg);
    }
    /* Forced colours drop author background colours; a system colour keeps the bars visible (#282). */
    @media (forced-colors: active) {
        .navigator-menu-opener span { forced-color-adjust: none; background-color: ButtonText; }
    }
    .navigator-menu-opener { border-radius: var(--radius-full); }
    @media (hover: hover) {
        .navigator-menu-opener:hover { background-color: var(--state-hover); }
    }
    .navigator-menu-opener:active { scale: .92; }

    dialog#site-menu[open]:not([data-closing]) .navigator-menu-opener { gap: 0; }
    dialog#site-menu[open]:not([data-closing]) .navigator-menu-opener span:first-of-type { transform: translateY(0.1rem) rotate(45deg); }
    dialog#site-menu[open]:not([data-closing]) .navigator-menu-opener span:last-of-type { transform: translateY(-0.1rem) rotate(-45deg); }

    @starting-style {
        dialog#site-menu[open]:not([data-closing]) .navigator-menu-opener { gap: var(--space-2); }
        dialog#site-menu[open]:not([data-closing]) .navigator-menu-opener span:first-of-type { transform: translateY(0) rotate(0deg); }
        dialog#site-menu[open]:not([data-closing]) .navigator-menu-opener span:last-of-type { transform: translateY(0) rotate(0deg); }
    }

    .navigator-menu-body {
        position: relative; z-index: 2; width: 100%; height: 100%;
        /* safe: a list taller than the dialog starts at the top edge, where it can scroll, instead of overflowing above it (#298). */
        display: flex; justify-content: center; align-items: safe center;
    }
    .navigator-menu-body ul {
        display: flex; flex-direction: column; align-items: center;
        gap: var(--space-12); list-style: none; padding: 0; margin: 0;
    }
    .navigator-menu-body li {
        opacity: 0; translate: 0 var(--space-6);
        transition: opacity var(--menu-item-exit) ease, translate var(--menu-item-exit) ease;
    }

    dialog#site-menu[open]:not([data-closing]) .navigator-menu-body li {
        opacity: 1; translate: 0 0;
        transition: opacity var(--duration-4) ease, translate var(--duration-4) var(--ease-in-out-strong);
        transition-delay: var(--menu-item-exit);
    }
    
    @starting-style {
        dialog#site-menu[open]:not([data-closing]) .navigator-menu-body li { opacity: 0; translate: 0 var(--space-6); }
    }
    dialog#site-menu[open]:not([data-closing]) .navigator-menu-body li:nth-child(2) { transition-delay: calc(var(--menu-item-exit) + var(--menu-item-step)); }
    dialog#site-menu[open]:not([data-closing]) .navigator-menu-body li:nth-child(3) { transition-delay: calc(var(--menu-item-exit) + 2 * var(--menu-item-step)); }

    .navigator-menu-body ul li a { display: flex; color: var(--font-color); text-decoration: none; }
    /* Plain text, not headings (#282): the links are navigation. */
    .navigator-menu-body ul li a span { text-decoration: underline transparent; text-underline-offset: var(--space-2); transition: text-decoration-color var(--duration-2) ease-out; }
    @media (hover: hover) {
        .navigator-menu-body ul li a:hover span { text-decoration-color: currentColor; }
    }
    .navigator-menu-body ul li a span {
        display: inline-block; font-size: var(--font-size-menu); font-weight: var(--font-weight-medium);
        line-height: 1.2; letter-spacing: var(--letter-spacing-tight); color: var(--font-color-bold);
    }
    /* At 400% zoom (320x180 CSS px) the list fits without scrolling: Firefox does not scroll a partly visible link into view on focus (#298). */
    @media (max-height: 20rem) {
        .navigator-menu-body ul { gap: var(--space-4); }
        .navigator-menu-body ul li a span { font-size: var(--font-size-2xl); }
    }
</style>
