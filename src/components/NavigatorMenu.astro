---
import { ROUTES } from "@/consts";
import BarsButton from "./BarsButton.astro";

const menuItems = [
  { name: "Home", path: ROUTES.home },
  { name: "About", path: ROUTES.about },
  { name: "Blog", path: ROUTES.blog },
  { name: "CV", path: ROUTES.cv },
];
---

<dialog id="site-menu" aria-label="Site navigation">
  <div class="navigator-menu-overlay" aria-hidden="true"></div>
  <BarsButton
    class="menu-close"
    commandfor="site-menu"
    command="close"
    aria-label="Close menu"
  />
  <div class="navigator-menu-body">
    <ul>
      {menuItems.map((item) => (
        <li>
          <a href={item.path}>
            <span>{item.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</dialog>

<script>
  // No HTML or CSS closes a dialog when a link navigates. Close it before the page enters the back/forward
  // cache, so Back restores it closed (https://developer.mozilla.org/en-US/docs/Web/API/Window/pagehide_event).
  const menu = document.getElementById("site-menu");
  if (menu instanceof HTMLDialogElement) {
    addEventListener("pagehide", () => menu.close());

    // CSS alone cannot animate the close in every engine: Firefox transitions neither display nor overlay, and
    // keeping the closed dialog rendered breaks WebKit's initial focus. So the close button's command and
    // Esc's cancel are held while data-closing plays the closing transitions, then the dialog closes.
    // getAnimations() applies pending style changes first, so it returns the transitions just started
    // (https://drafts.csswg.org/web-animations-1/#dom-animatable-getanimations).
    const closeAnimated = () => {
      if (menu.dataset.closing !== undefined) return;
      menu.dataset.closing = "";
      const running = menu
        .getAnimations({ subtree: true })
        .map((animation) => animation.finished);
      void Promise.allSettled(running).then(() => {
        menu.close();
        delete menu.dataset.closing;
      });
    };
    menu.addEventListener("command", (event) => {
      if (!(event instanceof CommandEvent) || event.command !== "close") return;
      event.preventDefault();
      closeAnimated();
    });
    menu.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeAnimated();
    });
  }
</script>

<style>
  dialog#site-menu {
    --menu-origin: var(--space-10) 2.6rem;
    /* The links fade out in --menu-item-exit; on open they wait that long, then enter one step apart. */
    --menu-item-exit: 0.25s;
    --menu-item-step: 80ms;
    margin: 0;
    padding: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    border: none;
    background: transparent;
    color: var(--font-color);
    display: none;
  }

  dialog#site-menu::backdrop {
    background: transparent;
  }
  /* While data-closing is set the dialog stays open and the parts transition back to their closed values. */
  dialog#site-menu[open] {
    display: block;
  }

  .navigator-menu-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: var(--body-background);
    clip-path: circle(0 at var(--menu-origin));
    transition: clip-path var(--duration-6) var(--ease-in-out-strong);
  }
  dialog#site-menu[open]:not([data-closing]) .navigator-menu-overlay {
    clip-path: circle(150vmax at var(--menu-origin));
  }

  @starting-style {
    dialog#site-menu[open]:not([data-closing]) .navigator-menu-overlay {
      clip-path: circle(0 at var(--menu-origin));
    }
  }

  /* Over the header hamburger: header padding, then the button centred in the header icon row. */
  .menu-close {
    position: absolute;
    z-index: 3;
    top: calc(var(--space-4) + (var(--size-icon-lg) - var(--space-12)) / 2);
    left: var(--space-4);
  }

  .navigator-menu-body {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    /* safe: a list taller than the dialog starts at the top edge, where it can scroll, instead of overflowing above it. */
    display: flex;
    justify-content: center;
    align-items: safe center;
  }
  .navigator-menu-body ul {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .navigator-menu-body li {
    opacity: 0;
    translate: 0 var(--space-6);
    transition:
      opacity var(--menu-item-exit) ease,
      translate var(--menu-item-exit) ease;
  }

  dialog#site-menu[open]:not([data-closing]) .navigator-menu-body li {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity var(--duration-4) ease,
      translate var(--duration-4) var(--ease-in-out-strong);
    transition-delay: var(--menu-item-exit);
    /* One step per item, whatever the count (https://developer.mozilla.org/en-US/docs/Web/CSS/sibling-index).
         A browser without it keeps the line above, and the items enter together. */
    transition-delay: calc(
      var(--menu-item-exit) + (sibling-index() - 1) * var(--menu-item-step)
    );
  }

  @starting-style {
    dialog#site-menu[open]:not([data-closing]) .navigator-menu-body li {
      opacity: 0;
      translate: 0 var(--space-6);
    }
  }

  .navigator-menu-body ul li a {
    display: flex;
    color: var(--font-color);
    text-decoration: none;
  }
  /* Plain text, not headings: the links are navigation. */
  .navigator-menu-body ul li a span {
    text-decoration: underline transparent;
    text-underline-offset: var(--space-2);
    transition: text-decoration-color var(--duration-2) ease-out;
  }
  @media (hover: hover) {
    .navigator-menu-body ul li a:hover span {
      text-decoration-color: currentColor;
    }
  }
  .navigator-menu-body ul li a span {
    display: inline-block;
    font-size: var(--font-size-menu);
    font-weight: var(--font-weight-medium);
    line-height: 1.2;
    letter-spacing: var(--letter-spacing-tight);
    color: var(--font-color-bold);
  }
  /* At 400% zoom (320x180 CSS px) the list fits without scrolling: Firefox does not scroll a partly visible link into view on focus. */
  @media (max-height: 20rem) {
    .navigator-menu-body ul {
      gap: var(--space-4);
    }
    .navigator-menu-body ul li a span {
      font-size: var(--font-size-2xl);
    }
  }
</style>
