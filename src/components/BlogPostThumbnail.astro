---
// A post as one link around a raised card: the category as kicker, the title, the description (#299, #300).
import Card from '@/components/Card.astro';
import DisplayHeading from '@/components/DisplayHeading.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import { getPostPath } from '@/lib/permalink';
import type { BlogPost } from '@/lib/posts';

interface Props {
  post: BlogPost;
  /** h2 under the blog index h1, h3 under the "Recommended articles" h2 (#307). */
  heading: 'h2' | 'h3';
}

const { post, heading } = Astro.props;
---

<a href={getPostPath(post)} class="blog-post-thumbnail" data-post-card>
  <Card as="article">
    <Eyebrow slash={false}>{post.data.category}</Eyebrow>
    <DisplayHeading as={heading} size="card" class="title" data-morph="title" text={post.data.title} />
    <p>{post.data.description}</p>
  </Card>
</a>

<style>
  /* The radius lets the keyboard focus outline follow the card's corners. */
  .blog-post-thumbnail {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-2xl);
  }

  /* Cards in one grid row share its height. */
  .blog-post-thumbnail article {
    block-size: 100%;
    transition: translate var(--duration-2) ease-out, background-color var(--duration-2) ease-out;
  }

  .title {
    margin: 0 0 var(--space-4);
    text-decoration: underline transparent;
    text-underline-offset: var(--space-1);
    transition: text-decoration-color var(--duration-2) ease-out;
  }

  /* Hover lifts the card one step off the page; only where the primary input can hover (MDN @media hover). */
  @media (hover: hover) {
    .blog-post-thumbnail:hover article {
      translate: 0 calc(-1 * var(--space-1));
      background-color: var(--thumbnail-bg-color-hover);
    }

    .blog-post-thumbnail:hover .title {
      text-decoration-color: currentColor;
    }
  }

  .blog-post-thumbnail:active article {
    translate: 0 0;
    transition-duration: calc(var(--duration-1) / 2);
  }
</style>
