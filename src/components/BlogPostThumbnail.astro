---
// A post as a raised card: the category as kicker, the title as the link to the post, the description.
import Card from "@/components/Card.astro";
import DisplayHeading from "@/components/DisplayHeading.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import { getPostPath } from "@/lib/permalink";
import type { BlogPost } from "@/lib/posts";

interface Props {
  post: BlogPost;
  /** h2 under the blog index h1, h3 under the "Recommended articles" h2. */
  heading: "h2" | "h3";
}

const { post, heading } = Astro.props;
---

{/* The link sits in the heading and wraps only the title, so its name is its own visible text (WCAG 2.5.3 Label in
    Name); its ::after covers the card, so a click anywhere opens the post
    (https://inclusive-components.design/cards/). The morph script finds the card by data-post-card and names the
    title inside it; the title is a block, since a view transition skips an element split over several lines. */}
<Card as="article" class="blog-post-thumbnail">
  <Eyebrow slash={false}>{post.data.category}</Eyebrow>
  <DisplayHeading as={heading} size="card" class="title">
    <a href={getPostPath(post)} class="link" data-post-card>
      <span class="name" data-morph="title">
        {post.data.title}
      </span>
    </a>
  </DisplayHeading>
  <p>{post.data.description}</p>
</Card>

<style>
  /* Cards in one grid row share its height. The card is the containing block of the link's ::after. */
  .blog-post-thumbnail {
    position: relative;
    block-size: 100%;
    transition:
      translate var(--duration-2) ease-out,
      background-color var(--duration-2) ease-out;
  }

  /* Blocks, so the title is one box for the morph and the focus ring outlines it; an inline link around a block
     draws its ring around empty line fragments. */
  .link,
  .name {
    display: block;
  }
  .link {
    color: inherit;
    text-decoration: none;
  }
  .link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .title {
    margin: 0 0 var(--space-4);
    text-decoration: underline transparent;
    text-underline-offset: var(--space-1);
    transition: text-decoration-color var(--duration-2) ease-out;
  }

  /* Hover lifts the card one step off the page; only where the primary input can hover (MDN @media hover). */
  @media (hover: hover) {
    .blog-post-thumbnail:hover {
      translate: 0 calc(-1 * var(--space-1));
      background-color: var(--thumbnail-bg-color-hover);
    }

    .blog-post-thumbnail:hover .title {
      text-decoration-color: currentColor;
    }
  }

  .blog-post-thumbnail:active {
    translate: 0 0;
    transition-duration: calc(var(--duration-1) / 2);
  }
</style>
