---
// A post as one link around a raised card: the category as kicker, the title, the description.
import Card from "@/components/Card.astro";
import DisplayHeading from "@/components/DisplayHeading.astro";
import DraftLabel from "@/components/DraftLabel.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import { getPostPath } from "@/lib/permalink";
import type { BlogPost } from "@/lib/posts";

interface Props {
  post: BlogPost;
  /** h2 under the blog index h1, h3 under the "Recommended articles" h2. */
  heading: "h2" | "h3";
}

const { post, heading } = Astro.props;
// Firefox computes no name from content for a link that only wraps an <article>, so the title names the link
// and the description describes it. A post appears once per page, so its id keeps them unique.
const titleId = `card-title-${post.id}`;
const descriptionId = `card-description-${post.id}`;
// A draft's label starts the link description, so a screen reader hears it with the title.
const draftId = `card-draft-${post.id}`;
const describedBy = post.data.draft
  ? `${draftId} ${descriptionId}`
  : descriptionId;
---

<a
  href={getPostPath(post)}
  class="blog-post-thumbnail"
  data-post-card
  aria-labelledby={titleId}
  aria-describedby={describedBy}
>
  <Card as="article">
    <div class="kicker">
      <Eyebrow slash={false}>{post.data.category}</Eyebrow>
      {post.data.draft && <DraftLabel id={draftId} />}
    </div>
    <DisplayHeading
      as={heading}
      size="card"
      class="title"
      data-morph="title"
      id={titleId}
      text={post.data.title}
    />
    <p id={descriptionId}>{post.data.description}</p>
  </Card>
</a>

<style>
  /* The radius lets the keyboard focus outline follow the card's corners. */
  .blog-post-thumbnail {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-2xl);
  }

  /* Cards in one grid row share its height. */
  .blog-post-thumbnail article {
    block-size: 100%;
    transition:
      translate var(--duration-2) ease-out,
      background-color var(--duration-2) ease-out;
  }

  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    margin-block-end: var(--space-2);
  }

  .kicker :global(.eyebrow) {
    margin: 0;
  }

  .title {
    margin: 0 0 var(--space-4);
    text-decoration: underline transparent;
    text-underline-offset: var(--space-1);
    transition: text-decoration-color var(--duration-2) ease-out;
  }

  /* Hover lifts the card one step off the page; only where the primary input can hover (MDN @media hover). */
  @media (hover: hover) {
    .blog-post-thumbnail:hover article {
      translate: 0 calc(-1 * var(--space-1));
      background-color: var(--thumbnail-bg-color-hover);
    }

    .blog-post-thumbnail:hover .title {
      text-decoration-color: currentColor;
    }
  }

  .blog-post-thumbnail:active article {
    translate: 0 0;
    transition-duration: calc(var(--duration-1) / 2);
  }
</style>
