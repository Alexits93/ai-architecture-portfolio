---
import SkillTag from '@/components/SkillTag.astro';
import { getPostPath } from '@/lib/permalink';
import type { BlogPost } from '@/lib/posts';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<a href={getPostPath(post)} class="blog-post-thumbnail" data-post-card>
  <article>
    <figure>
      <img src="/assets/images/placeholder.webp"
           data-morph="image"
           alt={post.data.title}
           height="200" width="420" loading="lazy" />
      <figcaption>{post.data.title}</figcaption>
    </figure>
    <div class="thumbnail-body">
      <div class="thumbnail-body-top">
        <h2 data-morph="title">{post.data.title}</h2>
        <p>{post.data.description}</p>
      </div>
      <div class="tags">
        <SkillTag skill={post.data.category} />
      </div>
    </div>
  </article>
</a>

<style>
  /* The radius lets the keyboard focus outline follow the card's corners. */
  .blog-post-thumbnail {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-lg);
  }

  .blog-post-thumbnail article {
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background-color: var(--thumbnail-bg-color);
    transition: translate .2s ease-out, background-color .2s ease-out;
  }

  .blog-post-thumbnail h2 {
    text-decoration: underline transparent;
    text-underline-offset: var(--space-1);
    transition: text-decoration-color .2s ease-out;
  }

  /* Hover lifts the card one step off the page; only where the primary input can hover (MDN @media hover). */
  @media (hover: hover) {
    .blog-post-thumbnail:hover article {
      translate: 0 calc(-1 * var(--space-1));
      background-color: var(--thumbnail-bg-color-hover);
    }

    .blog-post-thumbnail:hover h2 {
      text-decoration-color: currentColor;
    }
  }

  .blog-post-thumbnail:active article {
    translate: 0 0;
    transition-duration: .05s;
  }

  .blog-post-thumbnail article figure {
    margin: 0;
    margin-bottom: var(--space-4);
  }

  .blog-post-thumbnail article figure img {
    width: 100%;
    border-radius: var(--radius-lg);
    object-fit: cover;
    object-position: center;
  }

  .blog-post-thumbnail article figure figcaption {
    height: 0;
    width: 0;
    visibility: hidden;
  }

  .blog-post-thumbnail article .thumbnail-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .blog-post-thumbnail article .thumbnail-body .thumbnail-body-top h2 {
    color: var(--font-color-bold);
    margin: 0 0 var(--space-4);
    letter-spacing: var(--letter-spacing-tight);
    font-weight: var(--font-weight-medium);
    font-size: var(--font-size-md);
    line-height: var(--line-height-md);
  }

  .blog-post-thumbnail article .thumbnail-body .thumbnail-body-top p {
    margin: 0;
  }

  .blog-post-thumbnail article .thumbnail-body .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (min-width: 48rem) {
    .blog-post-thumbnail article .thumbnail-body {
      min-height: var(--size-thumbnail-body);
    }
  }

  @media (min-width: 64rem) {
    .blog-post-thumbnail article .thumbnail-body .thumbnail-body-top h2 {
      font-size: var(--font-size-xl);
      line-height: var(--line-height-lg);
    }
  }
</style>
