---
import { SkillTag } from '@/shared/ui/skill-tag';
import { getPostPath } from '../lib/permalink';
import type { BlogPost } from '../model/types';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<a href={getPostPath(post)} class="blog-post-thumbnail">
  <article>
    <figure>
      <img src="/assets/images/placeholder.webp"
           alt={post.data.title}
           height="200" width="420" loading="lazy" />
      <figcaption>{post.data.title}</figcaption>
    </figure>
    <div class="thumbnail-body">
      <div class="thumbnail-body-top">
        <h2>
          <span>
            {post.data.title}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </span>
        </h2>
        <p>{post.data.description}</p>
      </div>
      <div class="tags">
        {post.data.tags.map(tag => (
          <SkillTag skill={tag} />
        ))}
      </div>
    </div>
  </article>
</a>
