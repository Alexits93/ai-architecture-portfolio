{
  "anti-slop-guardrail": {
    "PreToolUse": [
      {
        "matcher": "write_to_file\\|replace_file_content",
        "hooks": [
          {
            "command": "node .agents/scripts/anti-slop-guard.js"
          }
        ]
      }
    ]
  },
  "gh-pr-safeguard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "command": "node .agents/scripts/gh-pr-hook.js"
          }
        ]
      }
    ]
  }
}
