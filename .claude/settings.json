{
  "autoMemoryEnabled": false,
  "enableArtifact": false,
  "skillOverrides": {
    "docx": "user-invocable-only",
    "pptx": "user-invocable-only",
    "xlsx": "user-invocable-only",
    "pdf": "user-invocable-only",
    "docs": "user-invocable-only",
    "morning": "user-invocable-only",
    "google-workspace": "user-invocable-only",
    "computer-use": "user-invocable-only",
    "built-in-browser": "user-invocable-only",
    "chrome-browser": "user-invocable-only",
    "import-memory": "user-invocable-only",
    "skill-creator": "user-invocable-only",
    "deep-research": "user-invocable-only",
    "dataviz": "user-invocable-only",
    "claude-api": "user-invocable-only",
    "claude-in-chrome": "user-invocable-only",
    "plugin-authoring": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "schedule": "user-invocable-only",
    "loop": "user-invocable-only"
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '(.context_window.total_input_tokens // 0) as $t | \"context \\($t / 1000 | floor)k / 150k\" + (if $t >= 130000 then \" \\u001b[31mHANDOVER NOW\\u001b[0m\" else \"\" end)'"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["gh issue *", "gh pr *", "gh run *", "git push *"],
    "filesystem": {
      "allowWrite": ["~/.local/share/pnpm", "~/.cache/pnpm"],
      "denyWrite": [
        "./CLAUDE.md",
        "./.claude",
        "./.github",
        "./.husky",
        "./eslint.config.mjs",
        "./vitest.config.ts",
        "./playwright.config.ts",
        "./tsconfig.json",
        "./astro.config.mjs",
        "./package.json",
        "./pnpm-lock.yaml",
        "./pnpm-workspace.yaml",
        "./.commitlintrc.json",
        "./.releaserc.json",
        "./public/_headers"
      ]
    },
    "network": {
      "allowedDomains": ["registry.npmjs.org", "github.com", "api.github.com"]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.gnupg", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.docker/config.json", "mode": "deny" },
        { "path": "~/.npmrc", "mode": "deny" }
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm build)",
      "Bash(pnpm preview)",
      "Bash(pnpm astro sync)",
      "Bash(pnpm audit *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec vitest run *)",
      "Bash(pnpm exec playwright test *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "WebFetch(domain:docs.astro.build)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:web.dev)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:eslint.org)",
      "WebFetch(domain:pnpm.io)",
      "WebFetch(domain:typescriptlang.org)",
      "WebFetch(domain:www.statichost.eu)",
      "WebFetch(domain:code.claude.com)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git branch -D *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue create *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm dlx *)",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/**)",
      "Edit(./.github/**)",
      "Edit(./.husky/**)",
      "Edit(./eslint.config.mjs)",
      "Edit(./vitest.config.ts)",
      "Edit(./playwright.config.ts)",
      "Edit(./tsconfig.json)",
      "Edit(./astro.config.mjs)",
      "Edit(./package.json)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./pnpm-workspace.yaml)",
      "Edit(./.npmrc)",
      "Edit(./.commitlintrc.json)",
      "Edit(./.releaserc.json)",
      "Edit(./public/_headers)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --no-verify *)",
      "Bash(git push --mirror *)",
      "Bash(git clean *)",
      "Bash(git stash *)",
      "Edit(./CHANGELOG.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-plan.mjs", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/anti-slop.mjs", "timeout": 10, "onFailure": "block" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-gate.mjs", "timeout": 30, "onFailure": "block" },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sandbox-gate.mjs", "timeout": 10, "onFailure": "block" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-feedback.mjs", "timeout": 60 }
        ]
      }
    ]
  }
}
