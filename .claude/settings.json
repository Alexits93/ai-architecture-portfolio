{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "enableArtifact": false,
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["gh issue *", "gh pr *", "gh run *", "git push *", "pnpm test:e2e:webkit"],
    "filesystem": {
      "allowWrite": ["~/.local/share/pnpm", "~/.cache/pnpm"],
      "denyWrite": [
        "./CLAUDE.md",
        "./.claude",
        "./.github",
        "./.husky",
        "./eslint.config.mjs",
        "./vitest.config.ts",
        "./playwright.config.ts",
        "./tsconfig.json",
        "./astro.config.mjs",
        "./package.json",
        "./pnpm-lock.yaml",
        "./pnpm-workspace.yaml",
        "./.commitlintrc.json",
        "./public/_headers"
      ]
    },
    "network": {
      "allowedDomains": ["registry.npmjs.org", "github.com", "api.github.com"]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.gnupg", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.docker/config.json", "mode": "deny" },
        { "path": "~/.npmrc", "mode": "deny" }
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm build)",
      "Bash(pnpm preview)",
      "Bash(pnpm astro sync)",
      "Bash(pnpm audit *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec vitest run *)",
      "Bash(pnpm exec playwright test *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "WebFetch(domain:docs.astro.build)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:web.dev)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:eslint.org)",
      "WebFetch(domain:pnpm.io)",
      "WebFetch(domain:typescriptlang.org)",
      "WebFetch(domain:www.statichost.eu)",
      "WebFetch(domain:code.claude.com)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(gh pr create *)",
      "Bash(gh issue create *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm dlx *)",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/**)",
      "Edit(./.github/**)",
      "Edit(./.husky/**)",
      "Edit(./eslint.config.mjs)",
      "Edit(./vitest.config.ts)",
      "Edit(./playwright.config.ts)",
      "Edit(./tsconfig.json)",
      "Edit(./astro.config.mjs)",
      "Edit(./package.json)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./pnpm-workspace.yaml)",
      "Edit(./.npmrc)",
      "Edit(./.commitlintrc.json)",
      "Edit(./public/_headers)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --no-verify *)",
      "Bash(git push --mirror *)",
      "Bash(git push * master)",
      "Bash(git push * HEAD:master)",
      "Bash(gh pr merge *)",
      "Bash(git clean *)",
      "Bash(git stash *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-feedback.mjs", "timeout": 60 }
        ]
      }
    ]
  }
}
